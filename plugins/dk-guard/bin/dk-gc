#!/usr/bin/env python3
"""dk-gc: remove what finished work left behind.

  dk-gc [--dry-run] [--yes] [--workspace DIR]
  dk-gc --in-use WORKTREE

Lists, grouped by repo, what finished work left behind: worktrees under the
workspace (default ~/workspace) whose branch's PR has merged, and those local
branches; remote branches of merged PRs that GitHub did not delete; dk-pg
databases (dk.issue, dk.root labels) whose issue is closed. Then it asks once
(y on stdin) and removes exactly what it listed. --dry-run lists and stops;
--yes skips the question (the guard asks the human before an agent passes it).

Nothing goes that cannot be tied to a merged PR (the branch tip is the PR's
head or behind it) or a closed issue. Never removed: main, master, pre-main,
the remote's default branch, verify-assets/* (PR bodies embed from them),
a branch with an open PR, the base of any PR (an integration branch like
pre-master, even after its own batch PR merged), a worktree with uncommitted
changes, a worktree with ignored files outside REGENERABLE (build output,
dependencies, generated code, test reports, a dev server's port file, .env*;
a listed name counts at any depth unless it names a folder holding tracked
files), whose "keep" line names them, and a worktree a process runs in (its
working directory inside, as lsof reports it), whose "keep" line names the
process and pid, or says lsof could not tell; the last five are listed with
"keep". The worktree checks run again just before each removal.
GitHub is asked with -R from origin's URL, so a GH_REPO in the environment
cannot point it at another repo. Checkouts of one GitHub repo share its remote
branches; the first one lists them.

--in-use WORKTREE runs only the process check, for a worktree removed by hand
(no merged PR): it prints why the worktree must stay and exits 1 (a path that
is no directory included), or prints nothing and exits 0. Run it from outside the worktree, or your own shell
counts.
"""
import argparse
import dataclasses
import fnmatch
import json
import os
import re
import subprocess
import sys

PROTECTED = {"main", "master", "pre-main"}
KEPT_PREFIX = "verify-assets/"  # PR bodies embed screenshots from these branches
# Ignored entries a worktree may lose: build output, dependencies, generated code, test reports,
# runtime files a dev server rewrites, local env.
REGENERABLE = ("node_modules", "dist", "build", ".next", ".output", "target", ".venv", "__pycache__",
               "test-results", ".api-port", ".tanstack", "*.tsbuildinfo", "*.gen.*", ".env*")
KEEP_LINE_NAMES = 5  # ignored entries or processes a "keep" line names before it counts the rest


def run(args, cwd=None):
    try:
        # git prints paths as raw bytes; surrogateescape keeps a name that is not UTF-8 intact
        out = subprocess.run(args, cwd=cwd, capture_output=True, encoding="utf-8", errors="surrogateescape")
    except OSError:
        return None
    return out.stdout if out.returncode == 0 else None


def shown(text):
    """Text for the terminal: a byte that is not UTF-8 in a path shows as \\xff instead of raising."""
    return text.encode("utf-8", "surrogateescape").decode("utf-8", "backslashreplace")


def git(path, *args):
    return run(["git", "-C", path, *args])


def gh_json(*args):
    out = run(["gh", *args])
    try:
        return json.loads(out) if out is not None else None
    except ValueError:
        return None


def slug_of(root):
    """owner/repo of origin on GitHub, from the configured URL (before any insteadOf)."""
    url = (git(root, "config", "--get", "remote.origin.url") or "").strip()
    m = re.search(r"github\.com[:/]([\w.-]+/[\w.-]+?)(?:\.git)?/?$", url)
    return m.group(1) if m else None


def main_roots(workspace):
    roots = []
    for entry in sorted(os.listdir(workspace)):
        path = os.path.join(workspace, entry)
        if not os.path.isdir(path) or not os.path.exists(os.path.join(path, ".git")):
            continue
        common = (git(path, "rev-parse", "--path-format=absolute", "--git-common-dir") or "").strip()
        if os.path.basename(common) == ".git":
            root = os.path.dirname(common)
            if root not in roots:
                roots.append(root)
    return roots


def worktrees(root):
    """[{path, head, branch, locked, prunable}] from `git worktree list --porcelain`; the main one first."""
    out, cur = [], None
    for line in (git(root, "worktree", "list", "--porcelain") or "").splitlines():
        key, _, value = line.partition(" ")
        if key == "worktree":
            cur = {"path": value, "head": None, "branch": None}
            out.append(cur)
        elif key == "HEAD":
            cur["head"] = value
        elif key == "branch":
            cur["branch"] = value[len("refs/heads/"):]
        elif key in ("locked", "prunable", "bare"):
            cur[key] = True
    return out


def regenerable(entry, tracked_dirs):
    """True when a path component of an ignored entry is on the REGENERABLE list and names a
    folder with no tracked file in it: a tool's output, not a tracked build/ holding notes."""
    parts = entry.rstrip("/").split("/")
    return any(fnmatch.fnmatchcase(name, pattern) and "/".join(parts[:i + 1]) not in tracked_dirs
               for i, name in enumerate(parts) for pattern in REGENERABLE)


def tracked_dirs(path):
    """Every folder that holds a tracked file, at any depth; None when git fails."""
    out = git(path, "ls-files", "-z")
    if out is None:
        return None
    dirs = set()
    for file in out.split("\0"):
        parts = file.split("/")[:-1]
        dirs.update("/".join(parts[:i + 1]) for i in range(len(parts)))
    return dirs


def listed(names):
    """The first KEEP_LINE_NAMES names, then a count of the rest."""
    more = f" and {len(names) - KEEP_LINE_NAMES} more" if len(names) > KEEP_LINE_NAMES else ""
    return f"{', '.join(names[:KEEP_LINE_NAMES])}{more}"


def worktree_blocker(path):
    """Why a worktree cannot go without losing work, or None: uncommitted changes, or ignored
    files outside REGENERABLE (`git worktree remove` deletes ignored files without asking)."""
    out = git(path, "status", "--porcelain", "-z", "--ignored=matching")
    if out is None:
        return "git status failed"
    entries = [e for e in out.split("\0") if e]
    if any(not e.startswith("!! ") for e in entries):
        return "uncommitted changes"
    if not entries:
        return None
    tracked = tracked_dirs(path)
    if tracked is None:
        return "git ls-files failed"
    at_risk = [e[3:] for e in entries if not regenerable(e[3:], tracked)]
    if not at_risk:
        return None
    return f"ignored files outside the regenerable list: {listed(at_risk)}"


def processes():
    """[(pid, command, cwd)] of the running processes lsof can see; None when lsof fails, since a
    listing it reports an error on may be missing a process."""
    try:  # from /, so lsof's own working directory is in no worktree
        out = subprocess.run(["lsof", "-w", "-d", "cwd", "-Fpcn"], cwd="/", capture_output=True,
                             env={**os.environ, "LC_ALL": "C"}, encoding="utf-8", errors="surrogateescape", timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return None
    rows, pid, command = [], None, ""
    for line in out.stdout.splitlines():
        tag, value = line[:1], line[1:]
        if tag == "p":
            pid, command = int(value), ""
        elif tag == "c":
            command = value
        elif tag == "n" and pid is not None:
            rows.append((pid, command, value))
    return rows or None  # lsof lists at least itself, so no rows means it did not run


LSOF_ESCAPES = {ord("\\"): "\\\\", ord("\b"): "\\b", ord("\f"): "\\f", ord("\n"): "\\n", ord("\r"): "\\r",
                ord("\t"): "\\t"}


def lsof_byte(b):
    """One byte of a path as lsof prints it in the C locale."""
    if b in LSOF_ESCAPES:
        return LSOF_ESCAPES[b]
    if 0x20 <= b < 0x7f:
        return chr(b)
    if b < 0x20:
        return f"^{chr(b + 0x40)}"  # ^A for 0x01
    return f"\\x{b:02x}"  # DEL and every byte outside ASCII


def as_lsof_prints(path):
    return "".join(lsof_byte(b) for b in os.fsencode(path))


class Processes:
    """The running processes and their working directories, read on first use."""
    def __init__(self):
        self.rows, self.read = None, False

    def blocker(self, path):
        """Why a process keeps the worktree at `path`, or None: the processes running in it, or
        that lsof could not tell, since removing the folder under one leaves it running nowhere."""
        if not self.read:
            self.rows, self.read = processes(), True
        if self.rows is None:
            return "cannot tell whether a process runs in it: lsof failed"
        inside = as_lsof_prints(os.path.realpath(path))
        found = [f"{command} (pid {pid})" for pid, command, cwd in self.rows
                 if pid != os.getpid() and (cwd == inside or cwd.startswith(inside + "/"))]
        if not found:
            return None
        return f"in use by {listed(found)}"


def databases():
    """[(dk.root, id, name, dk.issue)] of every dk-pg container, running or not; None without docker."""
    out = run(["docker", "ps", "-a", "--filter", "label=dk.issue", "--format",
               '{{.ID}}\t{{.Names}}\t{{.Label "dk.root"}}\t{{.Label "dk.issue"}}'])
    if out is None:
        return None
    rows = []
    for line in out.splitlines():
        cid, name, root, issue = (line.split("\t") + ["", "", ""])[:4]
        if cid and root and issue:
            rows.append((root, cid, name, issue))
    return rows


@dataclasses.dataclass(frozen=True)
class Worktree:
    kind = "worktree"
    label: str
    path: str
    head: str

    def remove(self, root):
        if (git(self.path, "rev-parse", "HEAD") or "").strip() != self.head:
            return "its branch moved since the listing"
        reason = worktree_blocker(self.path) or Processes().blocker(self.path)
        if reason:
            return f"{reason} (new since the listing)"
        if git(root, "worktree", "remove", self.path) is None:
            return "git worktree remove refused"
        return None


@dataclasses.dataclass(frozen=True)
class Branch:
    kind = "branch"
    label: str
    branch: str
    head: str

    def remove(self, root):
        if (git(root, "rev-parse", "-q", "--verify", f"refs/heads/{self.branch}") or "").strip() != self.head:
            return "it moved since the listing"
        if git(root, "branch", "-D", self.branch) is None:
            return "git branch -D refused"
        return None


@dataclasses.dataclass(frozen=True)
class RemoteBranch:
    kind = "remote"
    label: str
    branch: str
    head: str

    def remove(self, root):
        ref = f"refs/heads/{self.branch}"
        if git(root, "push", "-q", f"--force-with-lease={ref}:{self.head}", "origin", f":{ref}") is None:
            return "the push was refused; did it move since the listing?"
        return None


@dataclasses.dataclass(frozen=True)
class Database:
    kind = "database"
    label: str
    id: str

    def remove(self, root):
        return "docker rm failed" if run(["docker", "rm", "-fv", self.id]) is None else None


class Repo:
    def __init__(self, root, processes=None):
        self.root, self.name, self.slug = root, os.path.basename(root), slug_of(root)
        self.items, self.kept, self.notes = [], [], []
        self.merged, self.open_heads, self.bases = {}, {}, {}
        self.processes = processes or Processes()

    def load_prs(self):
        """Fetch merged and open PRs; False without a GitHub origin, or with a note when gh cannot list them."""
        if not self.slug:
            return False
        fields = "number,headRefName,headRefOid,baseRefName,isCrossRepository"
        merged = gh_json("pr", "list", "-R", self.slug, "--state", "merged", "--limit", "1000", "--json", fields)
        opened = gh_json("pr", "list", "-R", self.slug, "--state", "open", "--limit", "1000",
                         "--json", fields) if merged is not None else None
        if opened is None:
            self.notes.append("branches skipped: gh could not list its PRs")
            return False
        for p in merged:
            if not p.get("isCrossRepository"):
                self.merged.setdefault(p["headRefName"], []).append(p)
        for p in opened:
            if not p.get("isCrossRepository"):
                self.open_heads.setdefault(p["headRefName"], p)
        for kind, prs in (("open PR", opened), ("PR", merged)):  # a PR's base is an integration branch,
            for p in prs:                                           # even when its own batch PR merged
                self.bases.setdefault(p["baseRefName"], f"{kind} #{p['number']}")
        return True

    def merged_pr(self, branch, sha):
        """(pr, tied): a merged PR of the branch, tied when its head is `sha` or contains it, so nothing is lost."""
        prs = self.merged.get(branch, [])
        for p in prs:
            if p["headRefOid"] == sha or git(self.root, "merge-base", "--is-ancestor", sha, p["headRefOid"]) is not None:
                return p, True
        return (prs[0], False) if prs else (None, False)

    def blocker(self, branch, tied):
        """Why a branch with a merged PR stays, or None."""
        if branch in self.open_heads:
            return f"open PR #{self.open_heads[branch]['number']}"
        if branch in self.bases:
            return f"base of {self.bases[branch]}"
        if not tied:
            return "commits it did not merge"
        return None

    def consider(self, branch, sha, worktree=None, remote=False):
        if branch in PROTECTED or branch.startswith(KEPT_PREFIX):
            return
        pr, tied = self.merged_pr(branch, sha)
        if not pr:
            return
        why = f"PR #{pr['number']} merged"
        reason = self.blocker(branch, tied)
        if not reason and worktree:
            reason = worktree_blocker(worktree) or self.processes.blocker(worktree)
        detail = f"{why}; {reason}" if reason else why
        found = [Worktree(f"{worktree} ({branch}, {detail})", worktree, sha)] if worktree else []
        found.append(RemoteBranch(f"origin/{branch} ({detail})", branch, sha) if remote
                     else Branch(f"{branch} ({detail})", branch, sha))
        if reason:
            self.kept.append(found[0])
        else:
            self.items += found

    def scan(self, workspace, remote):
        if not self.load_prs():
            return
        inside = os.path.join(os.path.realpath(workspace), "")
        trees = worktrees(self.root)
        for wt in trees[1:]:
            if wt["branch"] and not wt.get("locked") and not wt.get("prunable") \
                    and os.path.join(os.path.realpath(wt["path"]), "").startswith(inside):
                self.consider(wt["branch"], wt["head"], worktree=wt["path"])
        checked_out = {wt["branch"] for wt in trees if wt["branch"]}
        refs = git(self.root, "for-each-ref", "--format=%(refname:short)%09%(objectname)", "refs/heads") or ""
        for line in refs.splitlines():
            branch, sha = line.split("\t")
            if branch not in checked_out:
                self.consider(branch, sha)
        if remote:
            self.scan_remote()

    def scan_remote(self):
        out = git(self.root, "ls-remote", "--symref", "origin", "HEAD", "refs/heads/*")
        if out is None:
            self.notes.append("remote branches skipped: origin did not answer")
            return
        heads, default = {}, None
        for line in out.splitlines():
            ref, _, name = line.partition("\t")
            if ref.startswith("ref: "):
                default = ref[len("ref: refs/heads/"):]
            elif name.startswith("refs/heads/"):
                heads[name[len("refs/heads/"):]] = ref
        for branch, sha in sorted(heads.items()):
            if branch != default:
                self.consider(branch, sha, remote=True)

    def consider_database(self, container):
        cid, name, issue = container
        if not self.slug:
            self.kept.append(Database(f"{name} (issue #{issue}; no GitHub checkout at {self.root})", cid))
            return
        if not issue.isdigit():
            self.kept.append(Database(f"{name} (issue {issue} is no issue number)", cid))
            return
        found = gh_json("issue", "view", issue, "-R", self.slug, "--json", "state")
        if not found:
            self.kept.append(Database(f"{name} (issue #{issue}; gh could not read it)", cid))
        elif found.get("state") == "CLOSED":
            self.items.append(Database(f"{name} (issue #{issue} closed)", cid))


def main():
    ap = argparse.ArgumentParser(prog="dk-gc", allow_abbrev=False, description="Remove worktrees, branches and dk-pg databases of finished work.")
    ap.add_argument("--dry-run", action="store_true", help="list, change nothing")
    ap.add_argument("--yes", action="store_true", help="remove without asking")
    ap.add_argument("--workspace", default=os.path.expanduser("~/workspace"))
    ap.add_argument("--in-use", metavar="WORKTREE",
                    help="only say whether a process runs in WORKTREE; exit 1 if one does or lsof cannot tell")
    args = ap.parse_args()
    if args.in_use:
        reason = Processes().blocker(args.in_use) if os.path.isdir(args.in_use) else "no such directory"
        if reason:
            print(shown(f"{args.in_use}: {reason}"))
        return 1 if reason else 0
    if not os.path.isdir(args.workspace):
        sys.exit(shown(f"dk-gc: no workspace at {args.workspace}"))

    processes = Processes()
    repos = [Repo(root, processes) for root in main_roots(args.workspace)]
    slugs = set()
    for repo in repos:
        repo.scan(args.workspace, remote=repo.slug not in slugs)
        slugs.add(repo.slug)
    containers = databases()
    if containers is None:
        print("databases skipped: docker did not answer")
    for root, cid, name, issue in containers or []:
        repo = next((r for r in repos if r.root == root), None)
        if repo is None:
            repo = Repo(root)
            repos.append(repo)
        repo.consider_database((cid, name, issue))
    count = 0
    for repo in repos:
        if not repo.items and not repo.kept and not repo.notes:
            continue
        print(shown(f"{repo.name} ({repo.slug or 'no GitHub origin'})"))
        for note in repo.notes:
            print(shown(f"  {note}"))
        for item in repo.items:
            print(shown(f"  remove {item.kind} {item.label}"))
            count += 1
        for item in repo.kept:
            print(shown(f"  keep {item.kind} {item.label}"))
    if not count:
        print("Nothing to remove.")
        return 0
    if args.dry_run:
        print(f"{count} to remove. Dry run: nothing changed.")
        return 0
    if not args.yes:
        print(f"Remove these {count}? [y/N] ", end="", flush=True)
        if sys.stdin.readline().strip().lower() not in ("y", "yes"):
            print("Nothing changed.")
            return 0
    failed = 0
    for repo in repos:
        for item in repo.items:
            error = item.remove(repo.root)
            if error:
                failed += 1
                print(shown(f"kept {item.kind} {item.label}: {error}"), file=sys.stderr)
    print(f"Removed {count - failed} of {count}.")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
