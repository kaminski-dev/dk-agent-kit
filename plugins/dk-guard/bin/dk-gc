#!/usr/bin/env python3
"""dk-gc: remove what finished work left behind.

  dk-gc [--dry-run] [--yes] [--workspace DIR]

Lists, grouped by repo, the worktrees under the workspace (default ~/workspace)
whose branch's PR has merged and those local branches, then asks once (y on
stdin) and removes exactly what it listed. --dry-run lists and stops; --yes
skips the question. Nothing is removed that cannot be tied to a merged PR.
"""
import argparse
import json
import os
import re
import subprocess
import sys

PROTECTED = {"main", "master", "pre-main"}
KEPT_PREFIX = "verify-assets/"  # PR bodies embed screenshots from these branches


def run(args, cwd=None):
    """stdout of a command, or None when it fails."""
    try:
        out = subprocess.run(args, cwd=cwd, capture_output=True, text=True)
    except OSError:
        return None
    return out.stdout if out.returncode == 0 else None


def git(path, *args):
    return run(["git", "-C", path, *args])


def gh_json(*args):
    out = run(["gh", *args])
    try:
        return json.loads(out) if out is not None else None
    except ValueError:
        return None


def slug_of(root):
    """owner/repo of origin on GitHub, from the configured URL (before any insteadOf)."""
    url = (git(root, "config", "--get", "remote.origin.url") or "").strip()
    m = re.search(r"github\.com[:/]([\w.-]+/[\w.-]+?)(?:\.git)?/?$", url)
    return m.group(1) if m else None


def main_roots(workspace):
    """The main checkouts of every repo with a checkout directly under the workspace."""
    roots = []
    for entry in sorted(os.listdir(workspace)):
        path = os.path.join(workspace, entry)
        if not os.path.isdir(path) or not os.path.exists(os.path.join(path, ".git")):
            continue
        common = (git(path, "rev-parse", "--path-format=absolute", "--git-common-dir") or "").strip()
        if os.path.basename(common) == ".git":
            root = os.path.dirname(common)
            if root not in roots:
                roots.append(root)
    return roots


def worktrees(root):
    """[{path, head, branch, locked, prunable}] from `git worktree list --porcelain`; the main one first."""
    out, cur = [], None
    for line in (git(root, "worktree", "list", "--porcelain") or "").splitlines():
        key, _, value = line.partition(" ")
        if key == "worktree":
            cur = {"path": value, "head": None, "branch": None}
            out.append(cur)
        elif key == "HEAD":
            cur["head"] = value
        elif key == "branch":
            cur["branch"] = value[len("refs/heads/"):]
        elif key in ("locked", "prunable", "bare"):
            cur[key] = True
    return out


class Repo:
    def __init__(self, root):
        self.root, self.name, self.slug = root, os.path.basename(root), slug_of(root)
        self.items, self.kept, self.notes = [], [], []
        self.merged, self.open_heads, self.open_bases = {}, {}, {}
        fields = "number,headRefName,headRefOid,baseRefName,isCrossRepository"
        merged = gh_json("pr", "list", "-R", self.slug, "--state", "merged", "--limit", "1000",
                         "--json", fields) if self.slug else None
        opened = gh_json("pr", "list", "-R", self.slug, "--state", "open", "--limit", "1000",
                         "--json", fields) if merged is not None else None
        if opened is None:
            self.notes.append("skipped: no GitHub origin or gh failed")
            return
        for p in merged:
            if not p.get("isCrossRepository"):
                self.merged.setdefault(p["headRefName"], []).append(p)
        for p in opened:
            if not p.get("isCrossRepository"):
                self.open_heads.setdefault(p["headRefName"], p)
            self.open_bases.setdefault(p["baseRefName"], p)

    def merged_pr(self, branch, sha):
        """(pr, tied): a merged PR of the branch, tied when its head is `sha` or contains it, so nothing is lost."""
        prs = self.merged.get(branch, [])
        for p in prs:
            if p["headRefOid"] == sha or git(self.root, "merge-base", "--is-ancestor", sha, p["headRefOid"]) is not None:
                return p, True
        return (prs[0], False) if prs else (None, False)

    def blocker(self, branch, tied, remote=False):
        """Why a branch with a merged PR stays, or None."""
        if branch in self.open_heads:
            return f"open PR #{self.open_heads[branch]['number']}"
        if remote and branch in self.open_bases:
            return f"base of open PR #{self.open_bases[branch]['number']}"
        if not tied:
            return "commits it did not merge"
        return None

    def consider(self, kind, label, branch, sha, target, remote=False):
        """Queue a branch tied to a merged PR, or list why it stays; skip it when no merged PR has it."""
        if branch in PROTECTED or branch.startswith(KEPT_PREFIX):
            return
        pr, tied = self.merged_pr(branch, sha)
        if not pr:
            return
        why = f"PR #{pr['number']} merged"
        reason = self.blocker(branch, tied, remote)
        if reason:
            self.kept.append((kind, f"{label} ({why}; {reason})"))
        else:
            self.items.append((kind, f"{label} ({why})", target))

    def scan(self, workspace):
        if self.notes:
            return
        inside = os.path.join(os.path.realpath(workspace), "")
        trees = worktrees(self.root)
        for wt in trees[1:]:
            branch, path = wt["branch"], wt["path"]
            if not branch or branch in PROTECTED or branch.startswith(KEPT_PREFIX) or wt.get("locked") \
                    or wt.get("prunable") or not os.path.join(os.path.realpath(path), "").startswith(inside):
                continue
            pr, tied = self.merged_pr(branch, wt["head"])
            if not pr:
                continue
            why = f"PR #{pr['number']} merged"
            reason = self.blocker(branch, tied)
            if not reason and git(path, "status", "--porcelain") != "":
                reason = "uncommitted changes"
            if reason:
                self.kept.append(("worktree", f"{path} ({branch}, {why}; {reason})"))
                continue
            self.items.append(("worktree", f"{path} ({branch}, {why})", wt))
            self.items.append(("branch", f"{branch} ({why})", {"branch": branch, "head": wt["head"]}))
        checked_out = {wt["branch"] for wt in trees if wt["branch"]}
        refs = git(self.root, "for-each-ref", "--format=%(refname:short)%09%(objectname)", "refs/heads") or ""
        for line in refs.splitlines():
            branch, sha = line.split("\t")
            if branch not in checked_out:
                self.consider("branch", branch, branch, sha, {"branch": branch, "head": sha})
        self.scan_remote()

    def scan_remote(self):
        out = git(self.root, "ls-remote", "--symref", "origin", "HEAD", "refs/heads/*")
        if out is None:
            self.notes.append("remote branches skipped: origin did not answer")
            return
        heads, default = {}, None
        for line in out.splitlines():
            ref, _, name = line.partition("\t")
            if ref.startswith("ref: "):
                default = ref[len("ref: refs/heads/"):]
            elif name.startswith("refs/heads/"):
                heads[name[len("refs/heads/"):]] = ref
        for branch, sha in sorted(heads.items()):
            if branch != default:
                self.consider("remote", f"origin/{branch}", branch, sha, {"branch": branch, "head": sha}, remote=True)

    def remove(self, kind, target):
        if kind == "worktree":
            if (git(target["path"], "rev-parse", "HEAD") or "").strip() != target["head"]:
                return "its branch moved since the listing"
            if git(self.root, "worktree", "remove", target["path"]) is None:
                return "git worktree remove refused"
        elif kind == "branch":
            if (git(self.root, "rev-parse", "-q", "--verify", f"refs/heads/{target['branch']}") or "").strip() \
                    != target["head"]:
                return "it moved since the listing"
            if git(self.root, "branch", "-D", target["branch"]) is None:
                return "git branch -D refused"
        elif kind == "remote":
            ref = f"refs/heads/{target['branch']}"
            if git(self.root, "push", "-q", f"--force-with-lease={ref}:{target['head']}", "origin", f":{ref}") is None:
                return "the push was refused; did it move since the listing?"
        return None


def main():
    ap = argparse.ArgumentParser(prog="dk-gc", description="Remove worktrees and branches of merged PRs.")
    ap.add_argument("--dry-run", action="store_true", help="list, change nothing")
    ap.add_argument("--yes", action="store_true", help="remove without asking")
    ap.add_argument("--workspace", default=os.path.expanduser("~/workspace"))
    args = ap.parse_args()
    if not os.path.isdir(args.workspace):
        sys.exit(f"dk-gc: no workspace at {args.workspace}")

    repos = [Repo(root) for root in main_roots(args.workspace)]
    for repo in repos:
        repo.scan(args.workspace)
    count = 0
    for repo in repos:
        if not repo.items and not repo.kept and not repo.notes:
            continue
        print(f"{repo.name} ({repo.slug or 'no GitHub origin'})")
        for note in repo.notes:
            print(f"  {note}")
        for kind, label, _ in repo.items:
            print(f"  remove {kind} {label}")
            count += 1
        for kind, label in repo.kept:
            print(f"  keep {kind} {label}")
    if not count:
        print("Nothing to remove.")
        return 0
    if args.dry_run:
        print(f"{count} to remove. Dry run: nothing changed.")
        return 0
    if not args.yes:
        print(f"Remove these {count}? [y/N] ", end="", flush=True)
        if sys.stdin.readline().strip().lower() not in ("y", "yes"):
            print("Nothing changed.")
            return 0
    failed = 0
    for repo in repos:
        for kind, label, target in repo.items:
            error = repo.remove(kind, target)
            if error:
                failed += 1
                print(f"kept {kind} {label}: {error}", file=sys.stderr)
    print(f"Removed {count - failed} of {count}.")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
