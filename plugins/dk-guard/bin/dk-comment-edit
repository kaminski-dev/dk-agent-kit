#!/usr/bin/env python3
"""dk-comment-edit: replace the body of an issue or PR comment an agent posted.

  dk-comment-edit <comment id> <file>

Replaces the comment's body with the file's and prints the comment's URL. The comment is in origin's
github.com repo, whatever GH_REPO or an upstream remote says, else in the repo gh reads ({owner}/{repo}); its id is the number in its URL (#issuecomment-<id>,
#discussion_r<id>). It edits only a comment the gh user wrote whose body opens with dk:issue-flow's
attribution note, and the new body must open with the note too, so the maintainer's own comments and
everyone else's stay as they are. The edit is a `gh api` PATCH run from here, so the command line itself
is not one the product repos ask about.
"""
import json
import os
import pathlib
import re
import subprocess
import sys

# dk:issue-flow's attribution note, the pattern its pr-wait matches; tests/test_dk_comment_edit.py keeps them equal.
ATTRIBUTION = re.compile(r"\A> \[!NOTE\]\r?\n> \*\*.+ responding on behalf of .+\*\*")


def die(msg, code=1):
    print(f"dk-comment-edit: {msg}", file=sys.stderr)
    sys.exit(code)


def origin_repo():
    """None when origin is no github.com repo. Read from the configured URL, before any insteadOf rewrites it."""
    url = subprocess.run(["git", "config", "--get", "remote.origin.url"], capture_output=True, text=True).stdout.strip()
    m = re.search(r"^(?:[\w.+-]+://(?:[^@/?#]+@)?|(?:[^@/:]+@)?)github\.com(?::\d+)?[:/]([\w.-]+/[\w.-]+?)(?:\.git)?/?$", url, re.I)
    return m.group(1) if m else None


def gh(*args):
    r = subprocess.run(["gh", *args], capture_output=True, text=True)
    return r.returncode, r.stdout, r.stderr.strip()


def main(argv):
    if len(argv) != 2 or not argv[0].isdigit():
        die("usage: dk-comment-edit <comment id> <file>", 2)
    cid, path = argv
    try:
        text = pathlib.Path(path).read_text()
    except OSError as e:
        die(f"cannot read {path}: {e.strerror}")
    if not ATTRIBUTION.match(text):
        die(f"{path} does not open with the attribution note; the new body keeps it, so the comment stays marked "
            "as an agent's")

    repo = origin_repo()
    if repo:
        os.environ["GH_REPO"] = repo  # an inherited GH_REPO would point gh at another repo
    code, login, err = gh("api", "user", "--jq", ".login")
    if code:
        die(f"gh api user failed: {err}")
    login = login.strip()

    for kind in ("issues", "pulls"):
        endpoint = f"repos/{repo or '{owner}/{repo}'}/{kind}/comments/{cid}"
        code, out, err = gh("api", endpoint)
        if code == 0:
            break
        if "HTTP 404" not in err:
            die(f"gh api {endpoint} failed: {err}")
    else:
        die(f"no issue or PR comment {cid} in this checkout's repo (both comment endpoints answered 404)")
    comment = json.loads(out)
    author = (comment.get("user") or {}).get("login") or "an unknown author"
    if author.lower() != login.lower():
        die(f"comment {cid} is {author}'s, not {login}'s; only your own comments are edited here")
    if not ATTRIBUTION.match(comment.get("body") or ""):
        die(f"comment {cid} does not open with the attribution note, so no agent posted it; it stays as it is")

    code, out, err = gh("api", "-X", "PATCH", endpoint, "-F", f"body=@{path}", "--jq", ".html_url")
    if code:
        die(f"gh api -X PATCH {endpoint} failed: {err}")
    print(out.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
