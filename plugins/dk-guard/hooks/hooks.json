{
  "description": "dk-guard: PreToolUse guard for Bash, fails closed if the script crashes or times out; a push gate on Bash that runs the pushed checkout's .claude/gate.sh before git push through dk-gate, which reuses a pass on the same tree and runs at most two gates at once and one per checkout, denies the push when the gate did not run and otherwise fails open; require-worktree on Edit|Write, fork-guard on Agent and a SessionStart baseline, all three fail open. Every hook starts with the interpreter scripts/find-python.sh names: the one pyenv would pick, without its shim.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}\"/scripts/find-python.sh && exec \"$dk_python\" -I \"${CLAUDE_PLUGIN_ROOT}\"/scripts/guard-bash-cached.py",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}\"/scripts/find-python.sh && exec \"$dk_python\" -I \"${CLAUDE_PLUGIN_ROOT}\"/scripts/push-gate.py",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}\"/scripts/find-python.sh && exec \"$dk_python\" -I \"${CLAUDE_PLUGIN_ROOT}\"/scripts/require-worktree.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}\"/scripts/find-python.sh && exec \"$dk_python\" -I \"${CLAUDE_PLUGIN_ROOT}\"/scripts/fork-guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}\"/scripts/find-python.sh && exec \"$dk_python\" -I \"${CLAUDE_PLUGIN_ROOT}\"/scripts/session-baseline.py",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
