{
  "description": "dk-guard: PreToolUse guard for Bash, fails closed if the script crashes or times out; a push gate on Bash that runs the pushed checkout's .claude/gate.sh before git push through dk-gate, which reuses a pass on the same tree and runs at most two gates at once, denies the push when no slot frees in time and otherwise fails open; require-worktree on Edit|Write, fork-guard on Agent and a SessionStart baseline, all three fail open. Every hook starts through scripts/run-hook, which starts the interpreter pyenv would pick without its shim.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "exec sh \"${CLAUDE_PLUGIN_ROOT}\"/scripts/run-hook guard-bash-cached",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "exec sh \"${CLAUDE_PLUGIN_ROOT}\"/scripts/run-hook push-gate",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "exec sh \"${CLAUDE_PLUGIN_ROOT}\"/scripts/run-hook require-worktree",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "exec sh \"${CLAUDE_PLUGIN_ROOT}\"/scripts/run-hook fork-guard",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec sh \"${CLAUDE_PLUGIN_ROOT}\"/scripts/run-hook session-baseline",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
