{
  "description": "dk-guard: PreToolUse guard for Bash, fails closed if the script crashes or times out; Stop gate that runs the repo's .claude/gate.sh, fails open; require-worktree on Edit|Write and a SessionStart baseline, both fail open.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}\"/scripts/guard-bash.py",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}\"/scripts/require-worktree.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}\"/scripts/session-baseline.py",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}\"/scripts/stop-gate.py",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
