{
  "description": "dk-guard: PreToolUse guard for Bash; fails closed if the script crashes or times out.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}\"/scripts/guard-bash.py",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
