#!/bin/sh
# Starts a dk-guard hook: run-hook <name> runs <name>.py beside this file under `python3 -I`.
#
# hooks.json calls it as `exec sh …/run-hook <name>`, so the interpreter replaces the `sh -c` the harness
# started and the lookup costs no process. When the first python3 on PATH is pyenv's shim, a bash script
# that starts `pyenv exec` and takes about 80 ms, this starts the interpreter pyenv would pick instead:
# <pyenv root>/versions/<version>/bin/python3, the version read as pyenv reads it, from PYENV_VERSION, else
# the nearest .python-version from the working directory up, else <pyenv root>/version.
#
# Whatever is not settled that simply goes to `python3` on PATH, as before this file: no pyenv, another
# version manager's shim, PYENV_DIR, several versions, `system`, a version prefix or one that is not
# installed. A missing interpreter or script exits nonzero, which blocks the call where hooks.json says
# `onFailure: block`.
hook=${0%/*}/$1.py

first=
set -f
IFS=:
for dir in $PATH; do
    if [ -x "${dir:-.}/python3" ]; then
        first=${dir:-.}
        break
    fi
done
unset IFS

case $first in
*/shims)
    pyenv=${first%/shims}
    version=${PYENV_VERSION-}
    if [ -z "$version" ] && [ -z "${PYENV_DIR-}" ]; then
        file=$pyenv/version
        dir=$PWD
        while :; do
            if [ -f "$dir/.python-version" ]; then
                file=$dir/.python-version
                break
            fi
            case $dir in
            */*) dir=${dir%/*} ;;
            *) break ;;
            esac
        done
        if [ -r "$file" ]; then
            read -r version _ < "$file"
        fi
    fi
    case $version in
    '' | .* | */*) ;;  # a path out of versions/ is not a version: pyenv refuses it too
    *)
        if [ -x "$pyenv/versions/$version/bin/python3" ]; then
            exec "$pyenv/versions/$version/bin/python3" -I "$hook"
        fi
        ;;
    esac
    ;;
esac
exec python3 -I "$hook"
