#!/usr/bin/env python3
# Adapted from t3dotgg/tstack@1085050 skills/babysit-pr/scripts/pr-wait, MIT (© 2026 Theo Browne). Changed for dk-agent-kit: ends at a --minutes deadline (20 by default) restarted by a push to the head; the review bot and the bases it reviews come from docs/agents/workflow.md, Greptile and Macroscope gating removed; the gh user's comments are events, only those opening with dk:issue-flow's attribution note are skipped; the bot's verdict on the head (`reviews <id>...`, `clean`, `rate limited`, `paused`) taken over from wait-review.py; the repo comes from origin when neither --repo nor a URL names it; gh calls are bounded by the deadline.
"""pr-wait: watch one GitHub pull request and print one line per real event (dk:issue-flow step 6).

  python3 -I pr-wait <pr> [--until ready|green|any-change] [--repo owner/name] [--minutes 20] [--interval 20]

<pr> is a PR number or PR URL. Without --repo, the repo comes from the URL or
from origin's github.com URL in the current checkout, whatever GH_REPO says.
Stdout carries only events, one line each, so a monitor (Claude Code's Monitor
tool) wakes the agent once per real event. Progress and errors that do not end
the run go to stderr.

--until
  green       required checks passed on the current head (every CI check when
              the base branch requires none)
  ready       green, the review bot gave its verdict on the current head, no
              review thread is unresolved, and the merge state is known and not
              BEHIND (default)
  any-change  stop after the first poll that prints an event

The review bot is the one the **Review bot** line of the checkout's
docs/agents/workflow.md names: the first backticked login ending in [bot], on
the bases the line names in backticks (`main` when it names none). Without
that line it is coderabbitai[bot] on PRs into main; a line naming no login
means no bot. `ready` on a base the bot does not review waits for no bot.

Exit codes
  0  the --until condition is met, or the PR merged
  1  the condition cannot be met without action: a required check failed, the
     branch conflicts with its base, the PR closed, `ready` is blocked by
     unresolved threads, a BEHIND branch or a bot that will not review the head
     on its own, GitHub stayed unreachable, or the deadline passed (--minutes
     after the last head change)
  2  bad arguments, unknown PR, or another pr-wait already watches this PR

Events
  - a required check failed (name and link)
  - all checks finished on the head (one summary line)
  - a new comment, thread, or thread reply from anyone but the review bot, the
    gh user included, and a new review from anyone but a bot: reviews from any
    bot are skipped, and only the review bot's verdict is read; one that opens
    with the attribution note (dk:issue-flow step 6, **Comments.**) is the
    agent's own and skipped
  - the review bot's verdict on the head: `reviews <id>...` (the REST review
    ids step 6 reads findings by), `clean` (its summary reports no actionable
    comments), or `rate limited` or `paused` (it will not review on its own)
  - the base branch moved and the new commits touch files in this PR, or the
    files they touch could not be read (the next poll reads them again)
  - merge state became BEHIND or DIRTY
  - the PR merged or closed
  - the deadline passed

Comment edits are never events, and top-level comments from CI and deploy bots
(github-actions, Vercel) are skipped, because checks already carry that news.

State lives in ~/.local/state/pr-wait/. A lock makes a second watcher for the
same PR exit at once. A state file lets a restarted watcher report what arrived
while no watcher ran. The first run for a PR records what already exists and
reports only what comes after.
"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import html
import json
import os
import re
import subprocess
import sys
import time
from collections.abc import Sequence
from pathlib import Path
from typing import Any, NoReturn

DEFAULT_BOT = ("coderabbitai[bot]", {"main"})
# dk:issue-flow step 6's attribution note, which opens every comment the agent posts; tests/test_skills.py keeps
# this copy equal to the skill's
ATTRIBUTION = re.compile(r"\A> \[!NOTE\]\r?\n> \*\*.+ responding on behalf of .+\*\*")
# CodeRabbit's summary comment: the rate-limit and pause notices and the recent-review block name the commit they are
# about; the status block does not.
RATE_LIMITED = ("<!-- This is an auto-generated comment: rate limited by coderabbit.ai -->",
                "<!-- end of auto-generated comment: rate limited by coderabbit.ai -->")
RECENT = ("<!-- recent_review_start -->", "<!-- recent_review_end -->")
STATUS = ("<!-- recent_review_status_start -->", "<!-- recent_review_status_end -->")
NO_FINDINGS = "No actionable comments were generated in the recent review."
# CI and deploy bots report through checks. Their PR comments are status reports.
STATUS_BOTS = ("github-actions", "vercel", "netlify", "railway", "cloudflare")
STATE_DIR = Path.home() / ".local" / "state" / "pr-wait"
# A state file older than this describes an old session. Start a fresh baseline
# instead of replaying hours of comments as new events.
STALE_STATE_SECONDS = 6 * 3600
MAX_FAILED_POLLS = 10
GH_TIMEOUT = 60
TRANSIENT = re.compile(
    r"HTTP (5\d\d|429)|rate limit|timed? ?out|connection (reset|refused)|EOF|"
    r"temporar|could not resolve host|TLS handshake|Something went wrong",
    re.IGNORECASE,
)
FAILED = ("fail", "cancel")
# gh pr checks buckets, worst first. Duplicate names (push and pull_request runs
# of one job) collapse to the worst bucket.
RANK = {"fail": 4, "cancel": 3, "pending": 2, "pass": 1, "skipping": 0}

QUERY = """
query($owner: String!, $name: String!, $number: Int!) {
  viewer { login }
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      url state headRefOid baseRefName mergeStateStatus
      author { login }
      baseRef { target { oid } }
      comments(last: 100) { nodes { id url body author { login __typename } } }
      reviews(last: 100) {
        nodes { id databaseId url state body commit { oid } author { login __typename } }
      }
      reviewThreads(last: 100) {
        nodes {
          isResolved path line
          comments(first: 100) {
            nodes { id url body author { login __typename } pullRequestReview { databaseId } }
          }
        }
      }
    }
  }
}
"""

Json = dict[str, Any]
deadline = float("inf")  # monotonic; a push to the head moves it


class GhError(Exception):
    def __init__(self, message: str, transient: bool) -> None:
        super().__init__(message)
        self.transient = transient


def log(message: str) -> None:
    print(f"pr-wait: {message}", file=sys.stderr, flush=True)


def fail(message: str, code: int = 2) -> NoReturn:
    # Fatal messages go to stdout so a monitor shows the agent why it stopped.
    print(f"pr-wait: {message}", flush=True)
    sys.exit(code)


def gh(args: list[str], allow: tuple[int, ...] = (0,)) -> subprocess.CompletedProcess[str]:
    """Run gh. Retries transient failures (HTTP 5xx or 429, network) with backoff, within the deadline."""
    delay = 2
    for attempt in range(5):
        left = deadline - time.monotonic()
        try:
            proc = subprocess.run(["gh", *args], capture_output=True, text=True, timeout=max(1, min(GH_TIMEOUT, left)))
        except subprocess.TimeoutExpired:
            raise GhError(f"gh {' '.join(args[:2])} timed out", True)
        transient = proc.returncode != 0 and bool(TRANSIENT.search(proc.stderr))
        if not transient and proc.returncode in allow:
            return proc
        lines = proc.stderr.strip().splitlines()
        message = lines[-1] if lines else f"gh exited {proc.returncode}"
        if not transient or attempt == 4 or time.monotonic() + delay > deadline:
            raise GhError(message, transient)
        log(f"gh {' '.join(args[:2])}: {message}; retry in {delay}s")
        time.sleep(delay)
        delay *= 2
    raise AssertionError("unreachable")


def gh_lines(args: list[str]) -> list[str]:
    return [line for line in gh(args).stdout.splitlines() if line]


def origin_repo():
    """None when origin is no github.com repo. Read from the configured URL, before any insteadOf rewrites it."""
    url = subprocess.run(["git", "config", "--get", "remote.origin.url"], capture_output=True, text=True).stdout.strip()
    m = re.search(r"(?:^|[@/])github\.com(?::\d+)?[:/]([\w.-]+/[\w.-]+?)(?:\.git)?/?$", url, re.I)
    return m.group(1) if m else None


def review_bot() -> tuple[str | None, set[str]]:
    """The review bot's REST login and the bases it reviews, from the checkout's workflow.md."""
    root = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip()
    try:
        text = (Path(root) / "docs" / "agents" / "workflow.md").read_text() if root else ""
    except OSError:
        text = ""
    line = re.search(r"^.*\*\*Review bot\*\*.*$", text, re.M)
    if not line:
        return DEFAULT_BOT
    names = re.findall(r"`([^`\n]+)`", line.group(0))
    logins = [n for n in names if n.endswith("[bot]")]
    if not logins:
        return None, set()
    return logins[0], {n for n in names if not n.endswith("[bot]")} or {"main"}


def same_login(graphql_login: str | None, rest_login: str | None) -> bool:
    """GraphQL names a bot `coderabbitai`, REST `coderabbitai[bot]`."""
    return bool(rest_login) and (graphql_login or "").lower() == rest_login.lower().removesuffix("[bot]")


def bot_check(name: str, bot: str | None) -> bool:
    """A check run the review bot posts itself, which never gates: its whole name, in lowercase alphanumerics, is the
    login's stem, or the stem less a suffix of up to 4 characters (`CodeRabbit` for coderabbitai[bot])."""
    check = re.sub(r"[^a-z0-9]", "", name.lower())
    login = re.sub(r"[^a-z0-9]", "", (bot or "").lower().removesuffix("[bot]"))
    return bool(check) and login.startswith(check) and len(login) - len(check) <= 4


def who(node: Json) -> tuple[str, bool]:
    author = node.get("author") or {}
    return author.get("login") or "ghost", author.get("__typename") == "Bot"


def ours(node: Json) -> bool:
    """A comment the agent posted, which opens with the attribution note."""
    return bool(ATTRIBUTION.match(node.get("body") or ""))


def plain(body: str) -> str:
    body = re.sub(r"<!--.*?-->", " ", body or "", flags=re.DOTALL)
    return html.unescape(re.sub(r"<[^>]+>", " ", body))


def snippet(body: str, limit: int = 100) -> str:
    text = re.sub(r"\s+", " ", plain(body)).strip()
    return text if len(text) <= limit else text[: limit - 3] + "..."


def section(body: str, markers: tuple[str, str]) -> str:
    start, end = markers
    return body.split(start, 1)[1].split(end, 1)[0] if start in body else ""


def parse_target(raw: str | None, repo: str | None) -> tuple[str, int]:
    if raw is None or not raw.strip():
        fail("missing PR number. Did a variable expand to nothing? Usage: pr-wait <pr> [--repo owner/name]")
    url = re.fullmatch(r"https?://github\.com/([^/\s]+/[^/\s]+)/pull/(\d+)(?:[/?#]\S*)?", raw.strip())
    number = re.fullmatch(r"#?(\d+)", raw.strip())
    if url:
        repo = repo or url.group(1)
        pr = int(url.group(2))
    elif number:
        pr = int(number.group(1))
    else:
        fail(f"'{raw}' is not a PR number or PR URL")
    if pr <= 0:
        fail(f"'{raw}' is not a valid PR number")
    repo = repo or origin_repo()
    if not repo:
        fail("no --repo given and origin names no github.com repo: run it in the PR's checkout")
    if not re.fullmatch(r"[\w.-]+/[\w.-]+", repo):
        fail(f"'{repo}' is not owner/name")
    os.environ["GH_REPO"] = repo  # an inherited GH_REPO would point gh at another repo
    try:
        gh(["pr", "view", str(pr), "-R", repo, "--json", "number"])
    except GhError as error:
        if not error.transient:  # a transient failure is retried by the poll loop
            fail(f"cannot read {repo}#{pr}: {error}")
    return repo, pr


def lock(repo: str, pr: int) -> Any:
    """Hold a per-PR lock for the life of the process. The OS drops it on exit."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    handle = open(STATE_DIR / f"{repo.replace('/', '__')}__{pr}.lock", "a+")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.seek(0)
        pid = handle.read().strip() or "unknown"
        fail(
            f"pid {pid} already watches {repo}#{pr}, so this watcher exits to avoid "
            f"duplicate events. If no events reach you from it, run `kill {pid}` and start again."
        )
    handle.seek(0)
    handle.truncate()
    handle.write(str(os.getpid()))
    handle.flush()
    return handle


def required_checks(repo: str, base: str) -> set[str]:
    """Required check names for the base branch, from rulesets and classic branch
    protection. Knowing them up front means a required check that has not started
    yet counts as pending, instead of green by omission."""
    sources = (
        (
            f"repos/{repo}/rules/branches/{base}",
            '.[] | select(.type == "required_status_checks") | .parameters.required_status_checks[].context',
        ),
        (f"repos/{repo}/branches/{base}/protection/required_status_checks", ".contexts[]?, .checks[]?.context"),
    )
    names: set[str] = set()
    for path, jq in sources:
        try:
            names.update(gh_lines(["api", path, "--jq", jq]))
        except GhError as error:
            if "HTTP 404" not in str(error):  # 404 means no protection, which is normal
                raise  # the poll retries, rather than reading a failed read as none required
    return names


class Watcher:
    def __init__(self, repo: str, pr: int, until: str, interval: float, minutes: float,
                 bot: str | None, bases: set[str]) -> None:
        self.repo, self.pr, self.until, self.interval, self.minutes = repo, pr, until, interval, minutes
        self.bot, self.bases = bot, bases
        self.owner, self.name = repo.split("/")
        self.path = STATE_DIR / f"{repo.replace('/', '__')}__{pr}.json"
        state = self.load()
        # First run for this PR: record what exists and report nothing.
        self.baseline = state is None
        self.state: Json = state or {"reported": [], "base_oid": None, "merge_state": None}
        self.reported: set[str] = set(self.state["reported"])
        self.printed: set[str] = set()
        self.events = 0
        self.head: str | None = None
        self.required: set[str] | None = None
        self.prev_snapshot: list[tuple[str, str]] | None = None
        self.pr_files: dict[str, set[str]] = {}

    def load(self) -> Json | None:
        try:
            if time.time() - self.path.stat().st_mtime > STALE_STATE_SECONDS:
                return None
            return json.loads(self.path.read_text())
        except (OSError, ValueError):
            return None

    def save(self) -> None:
        self.state["reported"] = sorted(self.reported)
        tmp = self.path.with_suffix(".tmp")
        tmp.write_text(json.dumps(self.state))
        tmp.replace(self.path)

    def say(self, line: str) -> None:
        if line not in self.printed:
            self.printed.add(line)
            print(f"#{self.pr} {line}", flush=True)

    def emit(self, key: str, line: str) -> None:
        """Print an event once per PR, across restarts."""
        if key in self.reported:
            return
        self.reported.add(key)
        if not self.baseline:
            self.events += 1
            self.say(line)

    def finish(self, code: int, lines: Sequence[str] = ()) -> NoReturn:
        for line in lines:
            self.say(line)
        self.save()
        sys.exit(code)

    def fetch_pr(self) -> Json:
        proc = gh([
            "api", "graphql", "-f", f"query={QUERY}",
            "-f", f"owner={self.owner}", "-f", f"name={self.name}", "-F", f"number={self.pr}",
        ])
        data = json.loads(proc.stdout)["data"]
        pr = data["repository"]["pullRequest"]
        pr["viewer"] = data["viewer"]["login"]
        return pr

    def fetch_checks(self) -> dict[str, Json]:
        # gh pr checks exits 8 while checks are pending and 1 when one failed.
        # Those are states, not errors: read the JSON and ignore the exit code.
        proc = gh(["pr", "checks", str(self.pr), "-R", self.repo, "--json", "name,bucket,link,description"], allow=(0, 1, 8))
        if not proc.stdout.strip():
            if "no checks reported" in proc.stderr:
                return {}
            raise GhError(proc.stderr.strip() or f"gh pr checks exited {proc.returncode}", False)
        checks: dict[str, Json] = {}
        for row in json.loads(proc.stdout):
            current = checks.get(row["name"])
            if current is None or RANK.get(row["bucket"], 2) > RANK.get(current["bucket"], 2):
                checks[row["name"]] = row
        return checks

    def base_overlap(self, head: str, old: str, new: str) -> list[str] | None:
        """Files this PR touches that the new base commits also touch; None when they cannot be read."""
        try:
            if head not in self.pr_files:
                self.pr_files[head] = set(gh_lines(["pr", "diff", str(self.pr), "-R", self.repo, "--name-only"]))
            moved = gh_lines(["api", f"repos/{self.repo}/compare/{old}...{new}", "--jq", ".files[].filename"])
        except GhError as error:
            log(f"could not compare base commits: {error}")
            return None
        return sorted(self.pr_files[head].intersection(moved))

    def behind(self, base: str, base_oid: str | None, head: str) -> str:
        """How far the head is behind its base, for the green and ready lines."""
        if not base_oid:
            return ""
        try:
            count = gh(["api", f"repos/{self.repo}/compare/{base_oid}...{head}", "--jq", ".behind_by"]).stdout.strip()
        except GhError:
            return ""
        return f"; {count} commit{'' if count == '1' else 's'} behind {base}"

    def bot_verdict(self, head: str, comments: list[Json], reviews: list[Json], threads: list[Json]) -> str | None:
        """The review bot's verdict on head. A review counts when it has a body or starts a thread of its own;
        one holding only thread replies does not."""
        starters = {(nodes[0].get("pullRequestReview") or {}).get("databaseId")
                    for nodes in (t["comments"]["nodes"] for t in threads) if nodes and same_login(who(nodes[0])[0], self.bot)}
        ids = [str(r["databaseId"]) for r in reviews
               if same_login(who(r)[0], self.bot) and (r.get("commit") or {}).get("oid") == head
               and ((r.get("body") or "").strip() or r["databaseId"] in starters)]
        if ids:
            return "reviews " + " ".join(ids)
        for comment in comments:
            if not same_login(who(comment)[0], self.bot):
                continue
            body = comment.get("body") or ""
            if f"and {head}" in section(body, RATE_LIMITED):
                return "rate limited"
            if "Reviews paused" in body and f"Latest commit, not reviewed: {head}" in body:
                return "paused"
            if "review in progress" in body:
                return None
            recent = section(body, RECENT)  # names the reviewed range; the verdict sits here or in the status block
            if f"and {head}" in recent and (NO_FINDINGS in recent or NO_FINDINGS in section(body, STATUS)):
                return "clean"
        return None

    def poll(self) -> None:
        global deadline
        pr = self.fetch_pr()
        if pr["state"] == "MERGED":
            self.finish(0, [f"merged: {pr['url']}"])
        if pr["state"] == "CLOSED":
            self.finish(1, [f"closed without merging: {pr['url']}"])

        base = pr["baseRefName"]
        gating = bool(self.bot) and base in self.bases
        if self.required is None:
            self.required = required_checks(self.repo, base)
            gate = ", ".join(sorted(self.required)) or "none set, so every CI check gates"
            log(f"watching {self.repo}#{self.pr} until {self.until} for {self.minutes:g} minutes; required checks: {gate}; "
                f"review bot: {self.bot if gating else 'none on ' + base}")
        checks = self.fetch_checks()
        head = pr["headRefOid"]
        short = head[:7]
        if head != self.head:  # a push restarts the deadline
            self.head, deadline = head, time.monotonic() + self.minutes * 60
        comments = pr["comments"]["nodes"]
        reviews = pr["reviews"]["nodes"]
        threads = pr["reviewThreads"]["nodes"]
        self.events = 0

        # Required checks. With no required checks configured, every CI check
        # gates except the review bot's own check.
        gate = self.required or {name for name in checks if not bot_check(name, self.bot)}
        label = "required check" if self.required else "check"

        def bucket(name: str) -> str:
            return checks[name]["bucket"] if name in checks else "pending"

        fail_lines: list[str] = []
        for name in sorted(gate):
            if bucket(name) in FAILED:
                link = checks[name]["link"]
                fail_lines.append(f"{label} failed: {name} {link}")
                self.emit(f"fail:{head}:{name}:{link}", fail_lines[-1])
        watched = {name: c for name, c in checks.items() if not bot_check(name, self.bot)}
        gate_done = all(bucket(n) != "pending" for n in gate)  # no checks at all, once stable, count as done
        all_done = gate_done and all(c["bucket"] != "pending" for c in watched.values())
        # Checks appear a few seconds after a push. Two identical polls in a row
        # guard against calling a half-registered set of checks finished.
        snapshot = sorted((name, c["bucket"]) for name, c in watched.items())
        stable = snapshot == self.prev_snapshot
        self.prev_snapshot = snapshot
        green = gate_done and stable and not fail_lines

        # People and bots talking. Edits are never events. The maintainer and the agent share the gh account, so the
        # agent's own comments are told apart by their attribution note, and the review bot speaks through its verdict.
        for comment in comments:
            login, is_bot = who(comment)
            if ours(comment) or same_login(login, self.bot) or (is_bot and any(b in login for b in STATUS_BOTS)):
                continue
            self.emit(f"c:{comment['id']}", f"comment from {login}: {snippet(comment['body'])} {comment['url']}")
        for review in reviews:
            login, is_bot = who(review)
            if ours(review) or is_bot:
                continue
            if review["state"] in ("APPROVED", "CHANGES_REQUESTED") or review["body"].strip():
                state = review["state"].lower().replace("_", " ")
                self.emit(f"c:{review['id']}", f"review from {login} ({state}): {snippet(review['body'])} {review['url']}")
        unresolved: list[str] = []
        for thread in threads:
            nodes = thread["comments"]["nodes"]
            if not thread["isResolved"] and nodes:
                unresolved.append(nodes[0]["url"])
            where = f"{thread['path']}:{thread['line']}" if thread["line"] else thread["path"]
            for index, comment in enumerate(nodes):
                login, _ = who(comment)
                if ours(comment) or same_login(login, self.bot):
                    continue
                kind = "new thread" if index == 0 else "thread reply"
                self.emit(f"c:{comment['id']}", f"{kind} from {login} on {where}: {snippet(comment['body'])} {comment['url']}")

        # The review bot's verdict on the current head.
        verdict = self.bot_verdict(head, comments, reviews, threads) if self.bot else None
        bot_lines: list[str] = []
        if verdict in ("rate limited", "paused"):
            bot_lines = [f"{self.bot} {verdict} on {short}: it will not review this head on its own"]
        elif verdict:
            bot_lines = [f"{self.bot} reviewed {short}: {verdict}"]
        if verdict:
            self.emit(f"bot:{head}:{verdict}", bot_lines[0])
        bot_status = f"{self.bot} {verdict or 'pending'}" if gating else f"no review bot on {base}"

        # Base branch and merge state.
        base_oid = ((pr.get("baseRef") or {}).get("target") or {}).get("oid")
        old_base = self.state["base_oid"]
        touched: list[str] | None = []
        if base_oid and old_base and base_oid != old_base and not self.baseline:
            touched = self.base_overlap(head, old_base, base_oid)
            if touched is None:  # the saved base stays, so the next poll compares again
                self.emit(f"base-unread:{base_oid}",
                          f"{base} moved to {base_oid[:7]}; could not read whether it touches files in this PR")
            elif touched:
                more = f" and {len(touched) - 5} more" if len(touched) > 5 else ""
                self.emit(
                    f"base:{base_oid}",
                    f"{base} moved to {base_oid[:7]} and touches files in this PR: {', '.join(touched[:5])}{more}",
                )
        if base_oid and touched is not None:
            self.state["base_oid"] = base_oid
        merge_state = pr["mergeStateStatus"]
        dirty_line = f"merge state is DIRTY: the branch conflicts with {base}, rebase it"
        behind_line = f"merge state is BEHIND: update the branch from {base} before merging"
        if merge_state != "UNKNOWN":
            if merge_state in ("BEHIND", "DIRTY") and self.state["merge_state"] != merge_state:
                line = dirty_line if merge_state == "DIRTY" else behind_line
                self.emit(f"merge:{merge_state}:{head}:{base_oid}", line)
            self.state["merge_state"] = merge_state

        # One summary line per head once all checks finish.
        counts: dict[str, int] = {}
        for c in watched.values():
            counts[c["bucket"]] = counts.get(c["bucket"], 0) + 1
        failed_names = sorted(name for name, c in watched.items() if c["bucket"] in FAILED)
        parts = [
            ", ".join(f"{n} {b}" for b, n in sorted(counts.items()))
            + (f" ({', '.join(failed_names)})" if failed_names else "") or "no checks reported",
            f"required {sum(bucket(n) in ('pass', 'skipping') for n in self.required)}/{len(self.required)} green"
            if self.required
            else "",
            bot_status,
            f"{len(unresolved)} unresolved thread{'' if len(unresolved) == 1 else 's'}",
            f"merge state {merge_state}",
        ]
        summary = "; ".join(p for p in parts if p)
        checks_key = f"checks:{head}"

        # Decide whether to stop. A green or ready line carries the same summary
        # as the checks line, so it marks that event as reported.
        if self.until != "any-change":
            if merge_state == "DIRTY":
                self.finish(1, [dirty_line])
            if fail_lines:
                self.finish(1, fail_lines)
            if green and self.until == "green":
                self.reported.add(checks_key)
                self.finish(0, [f"green on {short}: {summary}{self.behind(base, base_oid, head)}"])
        if self.until == "ready":
            if gating and verdict in ("rate limited", "paused"):
                self.finish(1, bot_lines)
            # ready waits for the review bot's verdict only on a base it reviews.
            if green and (verdict or not gating):
                if unresolved:
                    s = "" if len(unresolved) == 1 else "s"
                    self.finish(1, bot_lines + [f"blocked by {len(unresolved)} unresolved thread{s} on {short}: {' '.join(unresolved)}"])
                if merge_state == "BEHIND":
                    self.finish(1, bot_lines + [behind_line])
                if merge_state and merge_state != "UNKNOWN":  # GitHub has not computed it yet: keep polling
                    self.reported.add(checks_key)
                    self.finish(0, bot_lines + [f"ready on {short}: {summary}{self.behind(base, base_oid, head)}"])
        if all_done and (stable or self.baseline):
            self.emit(checks_key, f"checks finished on {short}: {summary}")
        if self.until == "any-change" and self.events:
            self.finish(0)

    def run(self) -> NoReturn:
        global deadline
        deadline = time.monotonic() + self.minutes * 60
        failures = 0
        while True:
            try:
                self.poll()
                failures = 0
            except GhError as error:
                if not error.transient:
                    self.finish(1, [f"pr-wait stopped: {error}"])
                failures += 1
                log(f"poll failed ({failures}/{MAX_FAILED_POLLS}): {error}")
                if failures >= MAX_FAILED_POLLS:
                    self.finish(1, [f"pr-wait stopped: GitHub unreachable for {failures} polls: {error}"])
            else:
                self.save()
                if self.baseline:
                    log(f"baseline recorded for {self.repo}#{self.pr}; reporting only new events")
                self.baseline = False
            left = deadline - time.monotonic()
            if left <= 0:
                goal = "event" if self.until == "any-change" else self.until
                self.finish(1, [f"deadline passed: no {goal} on {(self.head or '?')[:7]} after {self.minutes:g} minutes"])
            time.sleep(min(self.interval, left))


def main() -> None:
    parser = argparse.ArgumentParser(prog="pr-wait", description="Watch a GitHub PR and print one line per real event.")
    parser.add_argument("pr", nargs="?", help="PR number or URL")
    parser.add_argument("--repo", help="owner/name (default: from the URL or origin)")
    parser.add_argument("--until", choices=("green", "ready", "any-change"), default="ready")
    parser.add_argument("--minutes", type=float, default=20, help="deadline after the last head change (default 20)")
    parser.add_argument("--interval", type=float, default=20, help="seconds between polls (default 20)")
    args = parser.parse_args()
    repo, pr = parse_target(args.pr, args.repo)
    _lock = lock(repo, pr)
    bot, bases = review_bot()
    Watcher(repo, pr, args.until, max(args.interval, 0), args.minutes, bot, bases).run()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
