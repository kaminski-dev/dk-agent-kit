@@ -0,0 +1,16 @@
+"""CSV export of one entity type's Audit Operations, for the owner's accountant."""
+import csv
+
+from ledger.audit_store import COLUMNS
+
+
+def export_entity_type(conn, entity_type, out):
+    rows = conn.execute(
+        f"SELECT {COLUMNS} FROM audit_logs"
+        " WHERE entity_type = '%s'" % entity_type
+        + " ORDER BY changed_at DESC, entity_id, action, changed_by, field_name"
+    ).fetchall()
+    writer = csv.writer(out)
+    writer.writerow(COLUMNS.split(", "))
+    writer.writerows(tuple(r) for r in rows)
+    return len(rows)
