@@ -0,0 +1,62 @@
+import sqlite3
+import unittest
+from datetime import datetime, timedelta, timezone
+
+from ledger.outbox import Outbox
+from ledger.web import OutboxTab, render_to_string
+
+NOW = datetime(2026, 10, 19, 9, 0, tzinfo=timezone.utc)
+
+
+class Provider:
+    def __init__(self, fail=False):
+        self.sent, self.fail = [], fail
+
+    def send(self, to, subject, body, idempotency_key=None):
+        self.sent.append((to, subject, body))
+        if self.fail:
+            raise ConnectionError("provider unreachable")
+
+
+def outbox(provider):
+    o = Outbox(sqlite3.connect(":memory:"), provider)
+    o.queue("accountant@example.com", "Week 41", "3 Customers changed", "2026-10-12T08:00:00Z")
+    o.queue("accountant@example.com", "Week 42", "1 Customer changed", "2026-10-19T08:00:00Z")
+    return o
+
+
+class OutboxList(unittest.TestCase):
+    def test_newest_first(self):
+        self.assertEqual([m["subject"] for m in outbox(Provider()).list()], ["Week 42", "Week 41"])
+
+    def test_an_empty_outbox_lists_nothing(self):
+        self.assertEqual(Outbox(sqlite3.connect(":memory:"), Provider()).list(), [])
+
+
+class SendNext(unittest.TestCase):
+    def test_oldest_message_first_and_each_once(self):
+        p = Provider()
+        o = outbox(p)
+        self.assertEqual([o.send_next(NOW), o.send_next(NOW), o.send_next(NOW)], [1, 2, None])
+        self.assertEqual([s[1] for s in p.sent], ["Week 41", "Week 42"])
+
+    def test_a_failed_send_waits_for_its_lease(self):
+        o = outbox(Provider(fail=True))
+        with self.assertRaises(ConnectionError):
+            o.send_next(NOW)
+        o.provider = Provider()
+        self.assertEqual(o.send_next(NOW), 2)
+        self.assertIsNone(o.send_next(NOW + timedelta(minutes=4)))
+        self.assertEqual(o.send_next(NOW + timedelta(minutes=6)), 1)
+
+
+class OutboxTabTest(unittest.TestCase):
+    def test_lists_each_message_and_whether_it_went_out(self):
+        render_to_string(OutboxTab([
+            {"subject": "Week 41", "recipient": "accountant@example.com", "sent_at": "2026-10-19T09:00:00Z"},
+            {"subject": "Week 42", "recipient": "accountant@example.com", "sent_at": None},
+        ]))
+
+
+if __name__ == "__main__":
+    unittest.main()
