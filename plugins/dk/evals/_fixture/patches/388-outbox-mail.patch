+"""Server-rendered components for the owner's pages."""
+from html import escape
+
+
+def render_to_string(component):
+    return component.render()
+
+
+class OutboxTab:
+    """Each message to the accountant, and whether it went out."""
+
+    def __init__(self, messages):
+        self.messages = messages
+
+    def render(self):
+        if not self.messages:
+            return "<p>No mail queued.</p>"
+        rows = "".join(
+            f"<tr><td>{escape(m['subject'])}</td><td>{escape(m['recipient'])}</td>"
+            f"<td>{'sent ' + m['sent_at'] if m['sent_at'] else 'queued'}</td></tr>"
+            for m in self.messages
+        )
+        return f'<table class="outbox">{rows}</table>'
diff --git a/tests/test_outbox.py b/tests/test_outbox.py
