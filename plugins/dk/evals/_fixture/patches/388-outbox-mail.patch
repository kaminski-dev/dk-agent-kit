+++ b/ledger/mail_provider.py
@@ -0,0 +1,18 @@
+"""Client for the mail provider's HTTP API."""
+import json
+import urllib.request
+
+API = "https://mail.example.com/v1/messages"
+
+
+class MailProvider:
+    def __init__(self, token):
+        self.token = token
+
+    def send(self, to, subject, body, idempotency_key=None):
+        """Send one message. The provider drops a send whose idempotency_key it accepted in the last 24 hours."""
+        headers = {"Authorization": f"Bearer {self.token}", "Content-Type": "application/json"}
+        if idempotency_key:
+            headers["Idempotency-Key"] = idempotency_key
+        payload = json.dumps({"to": to, "subject": subject, "body": body}).encode()
+        urllib.request.urlopen(urllib.request.Request(API, data=payload, headers=headers), timeout=30).close()
diff --git a/ledger/outbox.py b/ledger/outbox.py
new file mode 100644
index 0000000..96c36eb
--- /dev/null
+++ b/ledger/outbox.py
@@ -0,0 +1,60 @@
+"""The accountant's mail queue: `send-mail` claims one queued message at a time and sends it."""
+import sqlite3
+from datetime import timedelta
+
+LEASE = timedelta(minutes=5)
+
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS outbox (
+    id            INTEGER PRIMARY KEY,
+    recipient     TEXT NOT NULL,
+    subject       TEXT NOT NULL,
+    body          TEXT NOT NULL,
+    queued_at     TEXT NOT NULL,
+    claimed_until TEXT,
+    sent_at       TEXT
+)
+"""
+
+
+def stamp(t):
+    return t.strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+class Outbox:
+    def __init__(self, conn: sqlite3.Connection, provider):
+        self.conn = conn
+        self.conn.row_factory = sqlite3.Row
+        self.conn.execute(SCHEMA)
+        self.provider = provider
+
+    def queue(self, recipient, subject, body, queued_at):
+        self.conn.execute(
+            "INSERT INTO outbox (recipient, subject, body, queued_at) VALUES (?, ?, ?, ?)",
+            (recipient, subject, body, queued_at),
+        )
+        self.conn.commit()
+
+    def send_next(self, now):
+        """Claim the oldest due message for LEASE, send it and mark it sent. Returns its id, or None when none is due."""
+        with self.conn:
+            msg = self.conn.execute(
+                "UPDATE outbox SET claimed_until = ?"
+                " WHERE id = (SELECT id FROM outbox"
+                "             WHERE sent_at IS NULL AND (claimed_until IS NULL OR claimed_until < ?)"
+                "             ORDER BY queued_at, id LIMIT 1)"
+                " RETURNING id, recipient, subject, body",
+                (stamp(now + LEASE), stamp(now)),
+            ).fetchone()
+        if msg is None:
+            return None
+        self.provider.send(msg["recipient"], msg["subject"], msg["body"])
+        with self.conn:
+            self.conn.execute("UPDATE outbox SET sent_at = ? WHERE id = ?", (stamp(now), msg["id"]))
+        return msg["id"]
+
+    def list(self):
+        """Every message, newest first, as the Outbox tab shows it."""
+        return self.conn.execute(
+            "SELECT id, recipient, subject, queued_at, sent_at FROM outbox ORDER BY queued_at DESC, id DESC"
+        ).fetchall()
