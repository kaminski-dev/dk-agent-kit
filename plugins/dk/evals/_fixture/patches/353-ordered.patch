From 021f20f9d92117ddb3ab734cb4fe82289cff70ed Mon Sep 17 00:00:00 2001
From: Eval Agent <eval@example.com>
Date: Tue, 13 Oct 2026 11:01:55 +0200
Subject: [PATCH] Order Customer History rows like the Audit Log list (#353)

---
 ledger/audit_store.py     | 2 +-
 tests/test_audit_store.py | 6 ++++++
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/ledger/audit_store.py b/ledger/audit_store.py
index fe9d9cb..841aa91 100644
--- a/ledger/audit_store.py
+++ b/ledger/audit_store.py
@@ -47,7 +47,7 @@ class AuditStore:
         return self.conn.execute(
             f"SELECT {COLUMNS} FROM audit_logs"
             " WHERE entity_type = ? AND entity_id = ?"
-            " ORDER BY changed_at DESC"
+            " ORDER BY changed_at DESC, action, changed_by, field_name"
             " LIMIT ?",
             (entity_type, entity_id, limit),
         ).fetchall()
diff --git a/tests/test_audit_store.py b/tests/test_audit_store.py
index 8d08a19..46ff099 100644
--- a/tests/test_audit_store.py
+++ b/tests/test_audit_store.py
@@ -35,6 +35,12 @@ class EntityHistory(unittest.TestCase):
         s.record("customer", 1, "update", "owner", "2026-10-03T10:00:00Z", {"name": ("x", "z")})
         self.assertEqual([r["action"] for r in s.list_by_entity("customer", 1)], ["update", "create"])
 
+    def test_fields_of_one_operation_come_by_name(self):
+        s = store()
+        s.record("customer", 1, "update", "owner", "2026-10-02T10:00:00Z",
+                 {"phone": ("a", "b"), "email": ("c", "d"), "city": ("e", "f")})
+        self.assertEqual([r["field_name"] for r in s.list_by_entity("customer", 1)], ["city", "email", "phone"])
+
 
 if __name__ == "__main__":
     unittest.main()
