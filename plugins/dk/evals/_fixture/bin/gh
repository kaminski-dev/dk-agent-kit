#!/usr/bin/env python3
"""Stand-in for the GitHub CLI inside an eval workspace: nothing leaves the machine.

State lives in <workspace>/.tracker/state.json. Every call is logged to .tracker/calls.log.
.tracker/repos.log logs it too, as the repo it was asked for, a tab, the call; that repo is
--repo or -R, else GH_REPO, else `-` (the checkout's own). What the graders read is written as plain text:
.tracker/issue-<N>.md (labels, state and every comment), .tracker/pr.md
(the last PR opened, with the acceptance result for its head branch) and
.tracker/pulls/<N>.md (the last PR for issue N, read from a <type>/<N>-<slug> head); "last" is
the highest PR number, in whatever order their checks finish.
Calls hold a lock on the state, so parallel agents do not lose each other's writes; `pr create` lets
go of it while the acceptance check runs (at most CHECK_TIMEOUT seconds per run).
An issue's "blocked_by" lists its native blockers, read by `is:blocked` in a
search and by `gh api .../dependencies/blocked_by`, and added by a POST there, by
`gh issue create --blocked-by` or by `gh issue edit --add-blocked-by`.
That read pages at 30 as GitHub does: --paginate prints every page as its own JSON array
(--jq runs on each), or one array of pages with --slurp.
"search_qualifiers": false makes a search with is:blocked fail, as on a GitHub without it.
"other_repos" maps "owner/repo" to {number: state}, for `gh issue view N --repo owner/repo`.
An issue's "sub_issues" lists its sub-issues' numbers, read by `gh api .../issues/N/sub_issues`, paged as above.
A PR may hold isDraft, mergeable, mergeStateStatus, reviewDecision and headRefOid (origin's head when it
holds none), "checks" as rows of `gh pr checks` ({name, bucket, link}), "comments" ({author, body}),
"reviews" ({author, state, body, commit, databaseId}; without a commit, of whatever the head is) and "threads" ({path, line, isResolved, comments}, where
a comment's "review" is its review's databaseId). An author ending in [bot] is a bot.
"new_pr" in the state is stored on each PR `pr create` opens; "required_checks" maps a base to its check names.
`gh api graphql` answers one query: the one dk:issue-flow's pr-wait sends, field for field.
"""
import fcntl
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile

WS = pathlib.Path(__file__).resolve().parent.parent
TRACKER = WS / ".tracker"
STATE = TRACKER / "state.json"
NOW = "2026-10-13T09:00:00Z"
CHECK_TIMEOUT = 300
LOCK = None


def load():
    return json.loads(STATE.read_text())


def save(state):
    STATE.write_text(json.dumps(state, indent=2))
    for num, issue in state["issues"].items():
        lines = [f"# #{num} {issue['title']}", f"state: {issue['state']}",
                 "labels: " + ", ".join(issue["labels"]), ""]
        for c in issue["comments"]:
            lines += [f"--- comment by {c['author']}", c["body"], ""]
        (TRACKER / f"issue-{num}.md").write_text("\n".join(lines))


def fail(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def opts(args, flags_with_value, multi=()):
    """Split args into positionals and {flag: value}; flags in multi collect lists."""
    pos, out = [], {}
    i = 0
    while i < len(args):
        a = args[i]
        if a.startswith("-"):
            key, eq, val = a.partition("=")
            if key in flags_with_value:
                if not eq:
                    i += 1
                    val = args[i] if i < len(args) else ""
                if key in multi:
                    out.setdefault(key, []).append(val)
                else:
                    out[key] = val
            else:
                out[key] = True
        else:
            pos.append(a)
        i += 1
    return pos, out


def body_of(o):
    if "--body-file" in o or "-F" in o:
        src = o.get("--body-file") or o.get("-F")
        return sys.stdin.read() if src == "-" else pathlib.Path(src).read_text()
    return o.get("--body") or o.get("-b") or ""


def jq(text, expr):
    """Run gh's --jq expression on text and print the result; a jq error exits with jq's code."""
    r = subprocess.run(["jq", "-r", expr], input=text, capture_output=True, text=True)
    sys.stdout.write(r.stdout)
    sys.stderr.write(r.stderr)
    if r.returncode:
        sys.exit(r.returncode)


def emit(value, o):
    """Print JSON, through jq when --jq is given (as gh does)."""
    text = json.dumps(value, indent=2)
    if "--jq" in o or "-q" in o:
        jq(text, o.get("--jq") or o.get("-q"))
        sys.exit(0)
    print(text)


def emit_pages(items, o):
    """Print a list GitHub pages at 30 the way gh api does: the first page, or every page with --paginate."""
    pages = [items[i:i + 30] for i in range(0, len(items), 30)] or [[]]
    if "--paginate" not in o:
        emit(pages[0], o)
    elif "--slurp" in o:
        emit(pages, o)
    else:
        for page in pages:
            if "--jq" in o or "-q" in o:
                jq(json.dumps(page), o.get("--jq") or o.get("-q"))
            else:
                sys.stdout.write(json.dumps(page))


def issue_json(state, num):
    i = state["issues"][num]
    return {
        "number": int(num), "title": i["title"], "body": i["body"], "state": i["state"].upper(),
        "labels": [{"name": n} for n in i["labels"]],
        "comments": [{"author": {"login": c["author"]}, "body": c["body"], "createdAt": NOW} for c in i["comments"]],
        "author": {"login": i.get("author", "owner")}, "createdAt": i.get("createdAt", NOW),
        "url": f"https://github.com/{state['repo']}/issues/{num}",
    }


def open_blockers(state, num):
    return [b for b in state["issues"][num].get("blocked_by", []) if state["issues"][str(b)]["state"] == "open"]


def blockers_from(flag, o, state):
    """The numbers of this repo's issues that flag names. gh takes another repo's URL too; that issue is not in
    this tracker, so it fails as one gh cannot read."""
    nums = []
    for ref in [v.strip() for value in o.get(flag, []) for v in value.split(",") if v.strip()]:
        url = re.match(r"https?://([^/]+)/([^/]+/[^/]+)/(?:issues|pull)/(\d+)", ref)
        host, repo, num = url.groups() if url else ("github.com", state["repo"], ref.removeprefix("#"))
        if host.lower() != "github.com":
            error = f'issue reference "{ref}" belongs to a different host ({host}) than the current repository (github.com)'
        elif repo.lower() != state["repo"].lower():
            error = f"GraphQL: Could not resolve to a Repository with the name '{repo}'. (repository)"
        elif not num.isdigit():
            error = f'invalid issue format: "{ref}"'
        elif num not in state["issues"]:
            error = f"GraphQL: Could not resolve to an issue or pull request with the number of {num}."
        else:
            nums.append(int(num))
            continue
        fail(f'resolving {flag} reference "{ref}": {error}')
    return nums


def add_blockers(issue, blockers):
    issue["blocked_by"] = list(dict.fromkeys(issue.get("blocked_by", []) + blockers))


def blocked_filter(search):
    """is:blocked (an open blocker) or -is:blocked in a --search; other search terms are ignored."""
    words = (search or "").split()
    if "is:blocked" in words:
        return True
    if "-is:blocked" in words:
        return False
    return None


def pick(d, o):
    fields = o.get("--json")
    if not fields or fields is True:
        return d
    return {k: d.get(k) for k in fields.split(",")}


def issue_number(pos, state):
    if not pos:
        fail("issue number required")
    num = pos[0].lstrip("#").rsplit("/", 1)[-1]
    if num not in state["issues"]:
        fail(f"GraphQL: Could not resolve to an issue or pull request with the number of {num}.")
    return num


VALUE_FLAGS = {"--json", "--jq", "-q", "--body", "-b", "--body-file", "-F", "--add-label", "--remove-label",
               "--label", "-l", "--state", "-s", "--search", "-S", "--limit", "-L", "--title", "-t", "--base", "-B",
               "--head", "-H", "--repo", "-R", "--comment", "-c", "--reason", "-r", "--assignee", "-a", "--parent",
               "--add-sub-issue", "--blocked-by", "--add-blocked-by", "--method", "-X", "--field", "-f", "--raw-field", "--milestone", "-m",
               "--template", "-T", "--color", "--description", "-d"}
MULTI = {"--add-label", "--remove-label", "--label", "-l", "--field", "-f", "--raw-field", "--blocked-by",
         "--add-blocked-by"}


def labels_from(values):
    return [l.strip() for v in values or [] for l in v.split(",") if l.strip()]


def cmd_issue(sub, args, state):
    pos, o = opts(args, VALUE_FLAGS, MULTI)
    repo = o.get("--repo") or o.get("-R")
    if sub == "view" and repo and repo != state["repo"]:
        other = state.get("other_repos", {}).get(repo, {}).get(pos[0].lstrip("#") if pos else "")
        if other is None:
            fail(f"GraphQL: Could not resolve to an issue or pull request in {repo}.")
        emit(pick({"number": int(pos[0].lstrip("#")), "state": other.upper()}, o), o)
        return
    if sub == "view":
        num = issue_number(pos, state)
        d = issue_json(state, num)
        if "--json" in o:
            emit(pick(d, o), o)
        else:
            print(f"{d['title']} #{num}\n{d['state']} • labels: {', '.join(state['issues'][num]['labels'])}\n\n{d['body']}")
            if "--comments" in o:
                for c in d["comments"]:
                    print(f"\n--- {c['author']['login']}\n{c['body']}")
    elif sub == "list":
        want_state = (o.get("--state") or o.get("-s") or "open").lower()
        want_labels = labels_from(o.get("--label") or o.get("-l"))
        want_blocked = blocked_filter(o.get("--search") or o.get("-S"))
        if want_blocked is not None and state.get("search_qualifiers") is False:
            fail("HTTP 422: Validation Failed: the is:blocked qualifier is not supported")
        rows = []
        for num, i in state["issues"].items():
            if want_state != "all" and i["state"] != want_state:
                continue
            if any(l not in i["labels"] for l in want_labels):
                continue
            if want_blocked is not None and bool(open_blockers(state, num)) != want_blocked:
                continue
            rows.append(issue_json(state, num))
        rows = rows[:int(o.get("--limit") or o.get("-L") or 30)]
        if "--json" in o:
            emit([pick(r, o) for r in rows], o)
        else:
            for r in rows:
                print(f"{r['number']}\t{r['state']}\t{r['title']}")
    elif sub == "comment":
        num = issue_number(pos, state)
        body = body_of(o)
        if not body.strip():
            fail("body cannot be blank")
        state["issues"][num]["comments"].append({"author": "agent", "body": body})
        save(state)
        print(f"https://github.com/{state['repo']}/issues/{num}#issuecomment-{len(state['issues'][num]['comments'])}")
    elif sub == "edit":
        num = issue_number(pos, state)
        i = state["issues"][num]
        for l in labels_from(o.get("--remove-label")):
            if l in i["labels"]:
                i["labels"].remove(l)
        for l in labels_from(o.get("--add-label")):
            if l not in state["labels"]:
                fail(f"could not add label: '{l}' not found")
            if l not in i["labels"]:
                i["labels"].append(l)
        add_blockers(i, blockers_from("--add-blocked-by", o, state))
        if "--title" in o:
            i["title"] = o["--title"]
        if "--body" in o or "--body-file" in o:
            i["body"] = body_of(o)
        save(state)
        print(f"https://github.com/{state['repo']}/issues/{num}")
    elif sub in ("close", "reopen"):
        num = issue_number(pos, state)
        i = state["issues"][num]
        if o.get("--comment") or o.get("-c"):
            i["comments"].append({"author": "agent", "body": o.get("--comment") or o.get("-c")})
        i["state"] = "closed" if sub == "close" else "open"
        save(state)
    elif sub == "create":
        blockers = blockers_from("--blocked-by", o, state)
        num = str(max(int(n) for n in state["issues"]) + 1)
        state["issues"][num] = {"title": o.get("--title") or o.get("-t") or "", "body": body_of(o), "state": "open",
                                "labels": labels_from(o.get("--label") or o.get("-l")), "comments": [],
                                "author": "agent"}
        add_blockers(state["issues"][num], blockers)
        save(state)
        print(f"https://github.com/{state['repo']}/issues/{num}")
    else:
        fail(f"gh issue {sub}: not supported by this repo's tracker stand-in")


def current_branch(cwd):
    r = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=cwd, capture_output=True, text=True)
    return r.stdout.strip()


def issue_of(head):
    m = re.match(r"[^/]+/(\d+)-", head)
    return m.group(1) if m else None


def acceptance(head, num):
    """Check out head from the workspace's origin and run the repo's tests and issue num's hidden acceptance check.

    No lines when the issue has no check: the PR record then carries no verdict for it.
    """
    check = TRACKER / f"acceptance-{num}.py"
    if num is None or not check.exists():
        return []
    origin = WS / "origin.git"
    archive = subprocess.run(["git", "--git-dir", str(origin), "archive", f"refs/heads/{head}"], capture_output=True)
    if archive.returncode != 0:
        return [f"acceptance: fail (branch {head} is not on origin)"]
    src = pathlib.Path(tempfile.mkdtemp(prefix="pr-", dir=TRACKER))
    try:
        if subprocess.run(["tar", "-x", "-C", str(src)], input=archive.stdout, capture_output=True).returncode != 0:
            return [f"acceptance: fail (could not extract {head})"]
        unit = subprocess.run([sys.executable, "-m", "unittest", "discover", "-s", "tests", "-q"], cwd=src,
                              capture_output=True, text=True, timeout=CHECK_TIMEOUT)
        acc = subprocess.run([sys.executable, str(check), str(src)], capture_output=True, text=True,
                             timeout=CHECK_TIMEOUT)
    except subprocess.TimeoutExpired:
        return [f"acceptance: fail (a check ran past {CHECK_TIMEOUT} s)"]
    finally:
        shutil.rmtree(src, ignore_errors=True)
    return [f"unit tests: {'pass' if unit.returncode == 0 else 'fail'}",
            f"acceptance: {'pass' if acc.returncode == 0 else 'fail'}",
            (acc.stdout + acc.stderr).strip()]


def write_record(path, num, record):
    """Write PR num's record unless path holds a newer PR's: checks run unlocked and can finish out of order."""
    if path.exists():
        held = re.match(r"# PR #(\d+)", path.read_text())
        if held and int(held.group(1)) > num:
            return
    path.write_text(record)


def origin_git(*args):
    """git in the workspace's origin: its output, or None when git fails."""
    r = subprocess.run(["git", "--git-dir", str(WS / "origin.git"), *args], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def origin_oid(rev):
    return origin_git("rev-parse", "--verify", "--quiet", f"{rev}^{{commit}}")


def three_dot(base, head):
    ends = origin_oid(base), origin_oid(head)
    if None in ends or origin_git("merge-base", *ends) is None:
        fail("gh: Not Found (HTTP 404)")
    return "...".join(ends)


def spoken(pr_url, node_id, record):
    """What a comment, a review and a thread's comment share."""
    author = record.get("author", "owner")
    return {"id": node_id, "url": f"{pr_url}#{node_id}", "body": record.get("body", ""),
            "authorAssociation": record.get("authorAssociation", "OWNER"),
            "author": {"login": author.removesuffix("[bot]"), "__typename": "Bot" if author.endswith("[bot]") else "User"}}


# gh pr checks' bucket -> a check run's (status, conclusion)
CHECK_RUN = {"pass": ("COMPLETED", "SUCCESS"), "fail": ("COMPLETED", "FAILURE"), "pending": ("IN_PROGRESS", ""),
             "skipping": ("COMPLETED", "SKIPPED"), "cancel": ("COMPLETED", "CANCELLED")}


def check_run(row):
    status, conclusion = CHECK_RUN[row["bucket"]]
    return {"__typename": "CheckRun", "name": row["name"], "status": status, "conclusion": conclusion,
            "detailsUrl": row.get("link", "")}


def review(pr, i, record):
    return {**spoken(pr["url"], f"PRR_{i}", record), "databaseId": record.get("databaseId", i),
            "state": record.get("state", "COMMENTED"), "commit": {"oid": record.get("commit", pr["headRefOid"])}}


def pr_json(state, pr):
    d = {"isDraft": False, "mergeable": "UNKNOWN", "mergeStateStatus": "UNKNOWN", "reviewDecision": "", **pr,
         "url": f"https://github.com/{state['repo']}/pull/{pr['number']}", "headRefName": pr["head"],
         "baseRefName": pr["base"], "headRefOid": pr.get("headRefOid") or origin_oid(f"refs/heads/{pr['head']}") or "",
         "statusCheckRollup": [check_run(c) for c in pr.get("checks", [])]}
    d["comments"] = [spoken(d["url"], f"IC_{i}", c) for i, c in enumerate(pr.get("comments", []), 1)]
    d["reviews"] = [review(d, i, r) for i, r in enumerate(pr.get("reviews", []), 1)]
    d["latestReviews"] = list({r["author"]["login"]: r for r in d["reviews"]}.values())
    return d


def selection(query):
    """A GraphQL query's fields, each with its arguments, as {field: its own fields or None}; None for anything else."""
    m = re.fullmatch(r"\s*query\s*\([^)]*\)\s*\{(.*)\}\s*", query, re.S)
    tokens = iter(re.findall(r"[{}]|\w+(?:\([^)]*\))?|\S", m.group(1)) if m else [])

    def fields():
        out, last = {}, None
        for t in tokens:
            if t == "}":
                break
            if t == "{":
                out[last] = fields()
            else:
                out[t], last = None, t
        return out
    out = fields() if m else None
    return None if list(tokens) or query.count("{") != query.count("}") else out


def answer(fields, value, path="query"):
    """value read through a query's fields, which must be the ones it answers. A list's first item is a blank one:
    it checks the fields of a page that holds nothing."""
    if isinstance(value, list):
        return [answer(fields, v, path) for v in value][1:]
    if value is None:
        return None
    asked, held = set(fields or {}), set(value) if isinstance(value, dict) else set()
    if asked != held:
        fail(f"gh api graphql: {path} differs from the query this repo's tracker stand-in answers (pr-wait's) in "
             + ", ".join(sorted(map(str, asked ^ held))))
    if not held:
        return value
    return {k.partition("(")[0]: answer(fields[k], v, f"{path}.{k}") for k, v in value.items()}


def page(nodes, blank, kept):
    return {"totalCount": len(nodes), "nodes": [blank, *nodes[kept]]}


def pr_graphql(state, pr):
    """The PR as pr-wait's GraphQL query reads it, for answer()."""
    d = pr_json(state, pr)
    if not d["headRefOid"]:
        fail(f"gh: {d['headRefName']} is not on origin, so this repo's tracker stand-in has no head for PR #{d['number']}")
    base = origin_oid(f"refs/heads/{d['baseRefName']}")
    last = slice(-100, None)

    def thread_comment(node_id, record):
        return {"pullRequestReview": {"databaseId": record.get("review")}, **spoken(d["url"], node_id, record)}

    def thread(i, r):
        return {"isResolved": r.get("isResolved", False), "path": r.get("path"), "line": r.get("line"),
                "comments(first: 100)": page([thread_comment(f"PRRC_{i}_{j}", c) for j, c in enumerate(r.get("comments", []), 1)],
                                             thread_comment("", {}), slice(100))}
    return {**{k: d[k] for k in ("url", "state", "headRefOid", "baseRefName", "mergeStateStatus")},
            "author": {"login": pr.get("author", "agent")}, "baseRef": base and {"target": {"oid": base}},
            "comments(last: 100)": page(d["comments"], spoken(d["url"], "", {}), last),
            "reviews(last: 100)": page(d["reviews"], review(d, 0, {}), last),
            "reviewThreads(last: 100)": page([thread(i, r) for i, r in enumerate(pr.get("threads", []), 1)], thread(0, {}), last)}


def api_fields(o):
    """gh api's fields: each -f, and the last -F, which every other command takes for a body file."""
    values = [o["-F"]] if isinstance(o.get("-F"), str) else []
    values += [v for flag in ("--field", "-f", "--raw-field") for v in o.get(flag, [])]
    return dict(v.partition("=")[::2] for v in values)


def api_graphql(o, state):
    sent = api_fields(o)
    asked = selection(sent.get("query", ""))
    if asked is None:
        fail("gh api graphql: this repo's tracker stand-in answers pr-wait's query only")
    repo = f"{sent.get('owner')}/{sent.get('name')}"
    if repo != state["repo"]:
        fail(f"gh: Could not resolve to a Repository with the name '{repo}'.")
    prs = [p for p in state["prs"] if str(p["number"]) == sent.get("number")]
    if not prs:
        fail(f"gh: Could not resolve to a PullRequest with the number of {sent.get('number')}.")
    data = {"viewer": {"login": "agent"},
            "repository(owner: $owner, name: $name)": {"pullRequest(number: $number)": pr_graphql(state, prs[0])}}
    emit({"data": answer(asked, data)}, o)


def api_rules(base, o, state):
    names = state.get("required_checks", {}).get(base, [])
    emit([{"type": "required_status_checks", "parameters": {"required_status_checks": [{"context": n} for n in names]}}]
         if names else [], o)


def api_compare(spec, o):
    base, _, head = spec.partition("...")
    span = three_dot(base, head)
    behind, ahead = origin_git("rev-list", "--left-right", "--count", span).split()
    files = origin_git("diff", "--name-only", span).splitlines()
    emit({"ahead_by": int(ahead), "behind_by": int(behind), "files": [{"filename": f} for f in files]}, o)


def cmd_api(args, state):
    pos, o = opts(args, VALUE_FLAGS, MULTI)
    if pos == ["graphql"]:
        return api_graphql(o, state)
    method = (o.get("--method") or o.get("-X") or "GET").upper()
    parts = pos[0].strip("/").split("/") if pos else []
    if method == "GET" and parts[:3] == ["repos", *state["repo"].split("/")]:
        if parts[3:5] == ["rules", "branches"]:
            return api_rules("/".join(parts[5:]), o, state)
        if parts[3:4] == ["branches"] and parts[-2:] == ["protection", "required_status_checks"]:
            fail("gh: Branch not protected (HTTP 404)")
        if parts[3:4] == ["compare"]:
            return api_compare("/".join(parts[4:]), o)
    if method not in ("GET", "POST") or len(parts) < 5 or parts[:3] != ["repos", *state["repo"].split("/")] \
            or parts[3] != "issues":
        fail(f"gh api {method} {'/'.join(parts)}: not supported by this repo's tracker stand-in")
    num = parts[4]
    if num not in state["issues"]:
        fail("gh: Not Found (HTTP 404)")

    def rest_issue(n):
        i = state["issues"][n]
        return {"number": int(n), "id": 900000 + int(n), "title": i["title"], "body": i["body"], "state": i["state"],
                "labels": [{"name": l} for l in i["labels"]],
                "issue_dependencies_summary": {"blocked_by": len(open_blockers(state, n)),
                                               "total_blocked_by": len(i.get("blocked_by", []))}}
    if method == "POST" and parts[5:] == ["dependencies", "blocked_by"]:
        blocker = str(int(api_fields(o).get("issue_id", "0")) - 900000)
        if blocker not in state["issues"]:
            fail("gh: Validation Failed (HTTP 422): issue_id names no issue in this repository")
        add_blockers(state["issues"][num], [int(blocker)])
        save(state)
        emit(rest_issue(blocker), o)
    elif method == "POST":
        fail(f"gh api POST {'/'.join(parts)}: not supported by this repo's tracker stand-in")
    elif parts[5:] == []:
        emit(rest_issue(num), o)
    elif parts[5:] == ["sub_issues"]:
        emit_pages([rest_issue(str(s)) for s in state["issues"][num].get("sub_issues", [])], o)
    elif parts[5:] == ["dependencies", "blocked_by"]:
        emit_pages([rest_issue(str(b)) for b in state["issues"][num].get("blocked_by", [])], o)
    else:
        fail(f"gh api {'/'.join(parts)}: not supported by this repo's tracker stand-in")


def pr_checks(pr, o):
    rows = [{"link": "", "description": "", "state": next(s for s in reversed(CHECK_RUN[c["bucket"]]) if s), **c}
            for c in pr.get("checks", [])]
    if not rows:
        fail(f"no checks reported on the '{pr['head']}' branch")
    if "--json" in o:  # gh exits 0 here, whatever the checks say
        emit([pick(r, o) for r in rows], o)
        return
    for r in rows:
        print(f"{r['name']}\t{r['bucket']}\t0\t{r['link']}")
    buckets = {r["bucket"] for r in rows}
    sys.exit(1 if "fail" in buckets else 8 if "pending" in buckets else 0)


def cmd_pr(sub, args, state):
    pos, o = opts(args, VALUE_FLAGS - {"-d"} if sub == "create" else VALUE_FLAGS, MULTI)
    if sub == "create":
        head = o.get("--head") or o.get("-H") or current_branch(os.getcwd())
        base = o.get("--base") or o.get("-B") or "main"
        num = max([p["number"] for p in state["prs"]], default=0) + 1
        pr = {"number": num, "title": o.get("--title") or o.get("-t") or "", "body": body_of(o),
              "base": base, "head": head, "state": "OPEN", "isDraft": "--draft" in o or "-d" in o, "mergeable": "MERGEABLE",
              "mergeStateStatus": "CLEAN", "reviewDecision": "", **state.get("new_pr", {})}
        state["prs"].append(pr)
        save(state)
        issue = issue_of(head)
        fcntl.flock(LOCK, fcntl.LOCK_UN)
        checks = acceptance(head, issue)
        fcntl.flock(LOCK, fcntl.LOCK_EX)
        lines = [f"# PR #{num} {pr['title']}", f"base: {base}", f"head: {head}"] + checks
        record = "\n".join(lines) + "\n\n## Body\n\n" + pr["body"] + "\n"
        write_record(TRACKER / "pr.md", num, record)
        if issue:
            (TRACKER / "pulls").mkdir(exist_ok=True)
            write_record(TRACKER / "pulls" / f"{issue}.md", num, record)
        print(f"https://github.com/{state['repo']}/pull/{num}")
    elif sub in ("view", "list", "checks", "diff"):
        prs = state["prs"]
        if sub != "list":
            if pos:
                prs = [p for p in prs if str(p["number"]) == pos[0].lstrip("#")]
            else:
                prs = [p for p in prs if p["head"] == current_branch(os.getcwd())]
            if not prs:
                fail("no pull requests found")
        if sub == "view":
            emit(pick(pr_json(state, prs[0]), o), o)
        elif sub == "checks":
            pr_checks(prs[0], o)
        elif sub == "diff":
            if "--name-only" not in o:
                fail("gh pr diff without --name-only: not supported by this repo's tracker stand-in")
            print(origin_git("diff", "--name-only", three_dot(*(f"refs/heads/{prs[0][end]}" for end in ("base", "head")))))
        else:
            want_state = (o.get("--state") or o.get("-s") or "open").upper()
            for flag, key in (("--base", "base"), ("-B", "base"), ("--head", "head"), ("-H", "head")):
                if flag in o:
                    prs = [p for p in prs if p[key] == o[flag]]
            prs = [p for p in prs if want_state == "ALL" or p["state"] == want_state]
            emit([pick(pr_json(state, p), o) for p in prs][:int(o.get("--limit") or o.get("-L") or 30)], o)
    else:
        fail(f"gh pr {sub}: not supported by this repo's tracker stand-in")


def main(argv):
    global LOCK
    LOCK = open(TRACKER / ".lock", "w")
    fcntl.flock(LOCK, fcntl.LOCK_EX)
    call = " ".join(argv).replace("\n", " ")  # one line per call
    with open(TRACKER / "calls.log", "a") as log:
        log.write(call + "\n")
    asked = next((argv[i + 1] for i in range(len(argv) - 1) if argv[i] in ("--repo", "-R")), None)
    with open(TRACKER / "repos.log", "a") as log:
        log.write(f"{asked or os.environ.get('GH_REPO') or '-'}\t{call}\n")
    if not argv:
        fail("usage: gh <command>")
    state = load()
    cmd, rest = argv[0], argv[1:]
    sub, args = (rest[0], rest[1:]) if rest else ("", [])
    if cmd == "issue":
        cmd_issue(sub, args, state)
    elif cmd == "pr":
        cmd_pr(sub, args, state)
    elif cmd == "api":
        cmd_api(rest, state)
    elif cmd == "run" and sub in ("list", "view"):
        pos, o = opts(args, VALUE_FLAGS | {"--workflow", "-w", "--branch"}, MULTI)
        runs = state.get("runs", [])
        if "--branch" in o:
            runs = [r for r in runs if r["headBranch"] == o["--branch"]]
        if sub == "view":
            runs = [r for r in runs if pos and str(r["databaseId"]) == pos[0]]
            if not runs:
                fail("run not found")
            r = runs[0]
            print(f"X {r['headBranch']} ci-go #{r['databaseId']}\n\nJOBS\n✓ test\n✓ lint\nX Go Vulnerability Check"
                  if r["conclusion"] == "failure" else f"✓ {r['headBranch']} ci-go #{r['databaseId']}")
        else:
            emit([pick(r, o) for r in runs], o)
    elif cmd == "label" and sub == "list":
        _, o = opts(args, VALUE_FLAGS, MULTI)
        emit([{"name": l} for l in state["labels"]], o)
    elif cmd == "repo" and sub == "view":
        _, o = opts(args, VALUE_FLAGS, MULTI)
        emit(pick({"nameWithOwner": state["repo"], "defaultBranchRef": {"name": "main"}}, o), o)
    elif cmd == "auth" and sub == "status":
        print("github.com\n  ✓ Logged in to github.com (tracker stand-in)")
    else:
        fail(f"gh {cmd} {sub}: not supported by this repo's tracker stand-in")


if __name__ == "__main__":
    main(sys.argv[1:])
