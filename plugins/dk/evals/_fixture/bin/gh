#!/usr/bin/env python3
"""Stand-in for the GitHub CLI inside an eval workspace: nothing leaves the machine.

State lives in <workspace>/.tracker/state.json. Every call is logged to .tracker/calls.log.
.tracker/repos.log logs it too, as the repo it was asked for, a tab, the call; that repo is
--repo or -R, else GH_REPO, else `-` (the checkout's own). What the graders read is written as plain text:
.tracker/issue-<N>.md (labels, state and every comment), .tracker/pr.md
(the last PR opened, with the acceptance result for its head branch) and
.tracker/pulls/<N>.md (the last PR for issue N, read from a <type>/<N>-<slug> head); "last" is
the highest PR number, in whatever order their checks finish.
Calls hold a lock on the state, so parallel agents do not lose each other's writes; `pr create` lets
go of it while the acceptance check runs (at most CHECK_TIMEOUT seconds per run).
An issue's "blocked_by" lists its native blockers, read by `is:blocked` in a
search and by `gh api .../dependencies/blocked_by`, and added by a POST there.
That read pages at 30 as GitHub does: --paginate prints every page as its own JSON array
(--jq runs on each), or one array of pages with --slurp.
"search_qualifiers": false makes a search with is:blocked fail, as on a GitHub without it.
"other_repos" maps "owner/repo" to {number: state}, for `gh issue view N --repo owner/repo`.
"""
import fcntl
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile

WS = pathlib.Path(__file__).resolve().parent.parent
TRACKER = WS / ".tracker"
STATE = TRACKER / "state.json"
NOW = "2026-10-13T09:00:00Z"
CHECK_TIMEOUT = 300
LOCK = None


def load():
    return json.loads(STATE.read_text())


def save(state):
    STATE.write_text(json.dumps(state, indent=2))
    for num, issue in state["issues"].items():
        lines = [f"# #{num} {issue['title']}", f"state: {issue['state']}",
                 "labels: " + ", ".join(issue["labels"]), ""]
        for c in issue["comments"]:
            lines += [f"--- comment by {c['author']}", c["body"], ""]
        (TRACKER / f"issue-{num}.md").write_text("\n".join(lines))


def fail(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def opts(args, flags_with_value, multi=()):
    """Split args into positionals and {flag: value}; flags in multi collect lists."""
    pos, out = [], {}
    i = 0
    while i < len(args):
        a = args[i]
        if a.startswith("-"):
            key, eq, val = a.partition("=")
            if key in flags_with_value:
                if not eq:
                    i += 1
                    val = args[i] if i < len(args) else ""
                if key in multi:
                    out.setdefault(key, []).append(val)
                else:
                    out[key] = val
            else:
                out[key] = True
        else:
            pos.append(a)
        i += 1
    return pos, out


def body_of(o):
    if "--body-file" in o or "-F" in o:
        src = o.get("--body-file") or o.get("-F")
        return sys.stdin.read() if src == "-" else pathlib.Path(src).read_text()
    return o.get("--body") or o.get("-b") or ""


def jq(text, expr):
    """Run gh's --jq expression on text and print the result; a jq error exits with jq's code."""
    r = subprocess.run(["jq", "-r", expr], input=text, capture_output=True, text=True)
    sys.stdout.write(r.stdout)
    sys.stderr.write(r.stderr)
    if r.returncode:
        sys.exit(r.returncode)


def emit(value, o):
    """Print JSON, through jq when --jq is given (as gh does)."""
    text = json.dumps(value, indent=2)
    if "--jq" in o or "-q" in o:
        jq(text, o.get("--jq") or o.get("-q"))
        sys.exit(0)
    print(text)


def emit_pages(items, o):
    """Print a list GitHub pages at 30 the way gh api does: the first page, or every page with --paginate."""
    pages = [items[i:i + 30] for i in range(0, len(items), 30)] or [[]]
    if "--paginate" not in o:
        emit(pages[0], o)
    elif "--slurp" in o:
        emit(pages, o)
    else:
        for page in pages:
            if "--jq" in o or "-q" in o:
                jq(json.dumps(page), o.get("--jq") or o.get("-q"))
            else:
                sys.stdout.write(json.dumps(page))


def issue_json(state, num):
    i = state["issues"][num]
    return {
        "number": int(num), "title": i["title"], "body": i["body"], "state": i["state"].upper(),
        "labels": [{"name": n} for n in i["labels"]],
        "comments": [{"author": {"login": c["author"]}, "body": c["body"], "createdAt": NOW} for c in i["comments"]],
        "author": {"login": i.get("author", "owner")}, "createdAt": i.get("createdAt", NOW),
        "url": f"https://github.com/{state['repo']}/issues/{num}",
    }


def open_blockers(state, num):
    return [b for b in state["issues"][num].get("blocked_by", []) if state["issues"][str(b)]["state"] == "open"]


def blocked_filter(search):
    """is:blocked (an open blocker) or -is:blocked in a --search; other search terms are ignored."""
    words = (search or "").split()
    if "is:blocked" in words:
        return True
    if "-is:blocked" in words:
        return False
    return None


def pick(d, o):
    fields = o.get("--json")
    if not fields or fields is True:
        return d
    return {k: d.get(k) for k in fields.split(",")}


def issue_number(pos, state):
    if not pos:
        fail("issue number required")
    num = pos[0].lstrip("#").rsplit("/", 1)[-1]
    if num not in state["issues"]:
        fail(f"GraphQL: Could not resolve to an issue or pull request with the number of {num}.")
    return num


VALUE_FLAGS = {"--json", "--jq", "-q", "--body", "-b", "--body-file", "-F", "--add-label", "--remove-label",
               "--label", "-l", "--state", "-s", "--search", "-S", "--limit", "-L", "--title", "-t", "--base", "-B",
               "--head", "-H", "--repo", "-R", "--comment", "-c", "--reason", "-r", "--assignee", "-a", "--parent",
               "--add-sub-issue", "--method", "-X", "--field", "-f", "--raw-field", "--milestone", "-m",
               "--template", "-T", "--color", "--description", "-d"}
MULTI = {"--add-label", "--remove-label", "--label", "-l", "--field", "-f", "--raw-field"}


def labels_from(values):
    return [l.strip() for v in values or [] for l in v.split(",") if l.strip()]


def cmd_issue(sub, args, state):
    pos, o = opts(args, VALUE_FLAGS, MULTI)
    repo = o.get("--repo") or o.get("-R")
    if sub == "view" and repo and repo != state["repo"]:
        other = state.get("other_repos", {}).get(repo, {}).get(pos[0].lstrip("#") if pos else "")
        if other is None:
            fail(f"GraphQL: Could not resolve to an issue or pull request in {repo}.")
        emit(pick({"number": int(pos[0].lstrip("#")), "state": other.upper()}, o), o)
        return
    if sub == "view":
        num = issue_number(pos, state)
        d = issue_json(state, num)
        if "--json" in o:
            emit(pick(d, o), o)
        else:
            print(f"{d['title']} #{num}\n{d['state']} • labels: {', '.join(state['issues'][num]['labels'])}\n\n{d['body']}")
            if "--comments" in o:
                for c in d["comments"]:
                    print(f"\n--- {c['author']['login']}\n{c['body']}")
    elif sub == "list":
        want_state = (o.get("--state") or o.get("-s") or "open").lower()
        want_labels = labels_from(o.get("--label") or o.get("-l"))
        want_blocked = blocked_filter(o.get("--search") or o.get("-S"))
        if want_blocked is not None and state.get("search_qualifiers") is False:
            fail("HTTP 422: Validation Failed: the is:blocked qualifier is not supported")
        rows = []
        for num, i in state["issues"].items():
            if want_state != "all" and i["state"] != want_state:
                continue
            if any(l not in i["labels"] for l in want_labels):
                continue
            if want_blocked is not None and bool(open_blockers(state, num)) != want_blocked:
                continue
            rows.append(issue_json(state, num))
        rows = rows[:int(o.get("--limit") or o.get("-L") or 30)]
        if "--json" in o:
            emit([pick(r, o) for r in rows], o)
        else:
            for r in rows:
                print(f"{r['number']}\t{r['state']}\t{r['title']}")
    elif sub == "comment":
        num = issue_number(pos, state)
        body = body_of(o)
        if not body.strip():
            fail("body cannot be blank")
        state["issues"][num]["comments"].append({"author": "agent", "body": body})
        save(state)
        print(f"https://github.com/{state['repo']}/issues/{num}#issuecomment-{len(state['issues'][num]['comments'])}")
    elif sub == "edit":
        num = issue_number(pos, state)
        i = state["issues"][num]
        for l in labels_from(o.get("--remove-label")):
            if l in i["labels"]:
                i["labels"].remove(l)
        for l in labels_from(o.get("--add-label")):
            if l not in state["labels"]:
                fail(f"could not add label: '{l}' not found")
            if l not in i["labels"]:
                i["labels"].append(l)
        if "--title" in o:
            i["title"] = o["--title"]
        if "--body" in o or "--body-file" in o:
            i["body"] = body_of(o)
        save(state)
        print(f"https://github.com/{state['repo']}/issues/{num}")
    elif sub in ("close", "reopen"):
        num = issue_number(pos, state)
        i = state["issues"][num]
        if o.get("--comment") or o.get("-c"):
            i["comments"].append({"author": "agent", "body": o.get("--comment") or o.get("-c")})
        i["state"] = "closed" if sub == "close" else "open"
        save(state)
    elif sub == "create":
        num = str(max(int(n) for n in state["issues"]) + 1)
        state["issues"][num] = {"title": o.get("--title") or o.get("-t") or "", "body": body_of(o), "state": "open",
                                "labels": labels_from(o.get("--label") or o.get("-l")), "comments": [],
                                "author": "agent"}
        save(state)
        print(f"https://github.com/{state['repo']}/issues/{num}")
    else:
        fail(f"gh issue {sub}: not supported by this repo's tracker stand-in")


def current_branch(cwd):
    r = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=cwd, capture_output=True, text=True)
    return r.stdout.strip()


def issue_of(head):
    m = re.match(r"[^/]+/(\d+)-", head)
    return m.group(1) if m else None


def acceptance(head, num):
    """Check out head from the workspace's origin and run the repo's tests and issue num's hidden acceptance check.

    No lines when the issue has no check: the PR record then carries no verdict for it.
    """
    check = TRACKER / f"acceptance-{num}.py"
    if num is None or not check.exists():
        return []
    origin = WS / "origin.git"
    archive = subprocess.run(["git", "--git-dir", str(origin), "archive", f"refs/heads/{head}"], capture_output=True)
    if archive.returncode != 0:
        return [f"acceptance: fail (branch {head} is not on origin)"]
    src = pathlib.Path(tempfile.mkdtemp(prefix="pr-", dir=TRACKER))
    try:
        if subprocess.run(["tar", "-x", "-C", str(src)], input=archive.stdout, capture_output=True).returncode != 0:
            return [f"acceptance: fail (could not extract {head})"]
        unit = subprocess.run([sys.executable, "-m", "unittest", "discover", "-s", "tests", "-q"], cwd=src,
                              capture_output=True, text=True, timeout=CHECK_TIMEOUT)
        acc = subprocess.run([sys.executable, str(check), str(src)], capture_output=True, text=True,
                             timeout=CHECK_TIMEOUT)
    except subprocess.TimeoutExpired:
        return [f"acceptance: fail (a check ran past {CHECK_TIMEOUT} s)"]
    finally:
        shutil.rmtree(src, ignore_errors=True)
    return [f"unit tests: {'pass' if unit.returncode == 0 else 'fail'}",
            f"acceptance: {'pass' if acc.returncode == 0 else 'fail'}",
            (acc.stdout + acc.stderr).strip()]


def write_record(path, num, record):
    """Write PR num's record unless path holds a newer PR's: checks run unlocked and can finish out of order."""
    if path.exists():
        held = re.match(r"# PR #(\d+)", path.read_text())
        if held and int(held.group(1)) > num:
            return
    path.write_text(record)


def pr_json(state, pr):
    return {**pr, "url": f"https://github.com/{state['repo']}/pull/{pr['number']}"}


def cmd_api(args, state):
    pos, o = opts(args, VALUE_FLAGS, MULTI)
    method = (o.get("--method") or o.get("-X") or "GET").upper()
    parts = pos[0].strip("/").split("/") if pos else []
    if method not in ("GET", "POST") or len(parts) < 5 or parts[:3] != ["repos", *state["repo"].split("/")] \
            or parts[3] != "issues":
        fail(f"gh api {method} {'/'.join(parts)}: not supported by this repo's tracker stand-in")
    num = parts[4]
    if num not in state["issues"]:
        fail("gh: Not Found (HTTP 404)")

    def rest_issue(n):
        i = state["issues"][n]
        return {"number": int(n), "id": 900000 + int(n), "title": i["title"], "state": i["state"],
                "labels": [{"name": l} for l in i["labels"]],
                "issue_dependencies_summary": {"blocked_by": len(open_blockers(state, n)),
                                               "total_blocked_by": len(i.get("blocked_by", []))}}
    if method == "POST" and parts[5:] == ["dependencies", "blocked_by"]:
        values = [o["-F"]] if isinstance(o.get("-F"), str) else []
        values += [v for flag in ("--field", "-f", "--raw-field") for v in o.get(flag, [])]
        fields = dict(v.partition("=")[::2] for v in values)
        blocker = str(int(fields.get("issue_id", "0")) - 900000)
        if blocker not in state["issues"]:
            fail("gh: Validation Failed (HTTP 422): issue_id names no issue in this repository")
        blocked_by = state["issues"][num].setdefault("blocked_by", [])
        if int(blocker) not in blocked_by:
            blocked_by.append(int(blocker))
        save(state)
        emit(rest_issue(blocker), o)
    elif method == "POST":
        fail(f"gh api POST {'/'.join(parts)}: not supported by this repo's tracker stand-in")
    elif parts[5:] == []:
        emit(rest_issue(num), o)
    elif parts[5:] == ["dependencies", "blocked_by"]:
        emit_pages([rest_issue(str(b)) for b in state["issues"][num].get("blocked_by", [])], o)
    else:
        fail(f"gh api {'/'.join(parts)}: not supported by this repo's tracker stand-in")


def cmd_pr(sub, args, state):
    pos, o = opts(args, VALUE_FLAGS, MULTI)
    if sub == "create":
        head = o.get("--head") or o.get("-H") or current_branch(os.getcwd())
        base = o.get("--base") or o.get("-B") or "main"
        num = max([p["number"] for p in state["prs"]], default=0) + 1
        pr = {"number": num, "title": o.get("--title") or o.get("-t") or "", "body": body_of(o),
              "base": base, "head": head, "state": "OPEN"}
        state["prs"].append(pr)
        save(state)
        issue = issue_of(head)
        fcntl.flock(LOCK, fcntl.LOCK_UN)
        checks = acceptance(head, issue)
        fcntl.flock(LOCK, fcntl.LOCK_EX)
        lines = [f"# PR #{num} {pr['title']}", f"base: {base}", f"head: {head}"] + checks
        record = "\n".join(lines) + "\n\n## Body\n\n" + pr["body"] + "\n"
        write_record(TRACKER / "pr.md", num, record)
        if issue:
            (TRACKER / "pulls").mkdir(exist_ok=True)
            write_record(TRACKER / "pulls" / f"{issue}.md", num, record)
        print(f"https://github.com/{state['repo']}/pull/{num}")
    elif sub in ("view", "list"):
        prs = state["prs"]
        if sub == "view":
            if pos:
                prs = [p for p in prs if str(p["number"]) == pos[0].lstrip("#")]
            else:
                prs = [p for p in prs if p["head"] == current_branch(os.getcwd())]
            if not prs:
                fail("no pull requests found")
            emit(pick(pr_json(state, prs[0]), o), o)
        else:
            want_state = (o.get("--state") or o.get("-s") or "open").upper()
            for flag, key in (("--base", "base"), ("-B", "base"), ("--head", "head"), ("-H", "head")):
                if flag in o:
                    prs = [p for p in prs if p[key] == o[flag]]
            prs = [p for p in prs if want_state == "ALL" or p["state"] == want_state]
            emit([pick(pr_json(state, p), o) for p in prs][:int(o.get("--limit") or o.get("-L") or 30)], o)
    else:
        fail(f"gh pr {sub}: not supported by this repo's tracker stand-in")


def main(argv):
    global LOCK
    LOCK = open(TRACKER / ".lock", "w")
    fcntl.flock(LOCK, fcntl.LOCK_EX)
    with open(TRACKER / "calls.log", "a") as log:
        log.write(" ".join(argv) + "\n")
    asked = next((argv[i + 1] for i in range(len(argv) - 1) if argv[i] in ("--repo", "-R")), None)
    with open(TRACKER / "repos.log", "a") as log:
        log.write(f"{asked or os.environ.get('GH_REPO') or '-'}\t{' '.join(argv)}\n")
    if not argv:
        fail("usage: gh <command>")
    state = load()
    cmd, rest = argv[0], argv[1:]
    sub, args = (rest[0], rest[1:]) if rest else ("", [])
    if cmd == "issue":
        cmd_issue(sub, args, state)
    elif cmd == "pr":
        cmd_pr(sub, args, state)
    elif cmd == "api":
        cmd_api(rest, state)
    elif cmd == "run" and sub in ("list", "view"):
        pos, o = opts(args, VALUE_FLAGS | {"--workflow", "-w", "--branch"}, MULTI)
        runs = state.get("runs", [])
        if "--branch" in o:
            runs = [r for r in runs if r["headBranch"] == o["--branch"]]
        if sub == "view":
            runs = [r for r in runs if pos and str(r["databaseId"]) == pos[0]]
            if not runs:
                fail("run not found")
            r = runs[0]
            print(f"X {r['headBranch']} ci-go #{r['databaseId']}\n\nJOBS\n✓ test\n✓ lint\nX Go Vulnerability Check"
                  if r["conclusion"] == "failure" else f"✓ {r['headBranch']} ci-go #{r['databaseId']}")
        else:
            emit([pick(r, o) for r in runs], o)
    elif cmd == "label" and sub == "list":
        _, o = opts(args, VALUE_FLAGS, MULTI)
        emit([{"name": l} for l in state["labels"]], o)
    elif cmd == "repo" and sub == "view":
        _, o = opts(args, VALUE_FLAGS, MULTI)
        emit(pick({"nameWithOwner": state["repo"], "defaultBranchRef": {"name": "main"}}, o), o)
    elif cmd == "auth" and sub == "status":
        print("github.com\n  ✓ Logged in to github.com (tracker stand-in)")
    else:
        fail(f"gh {cmd} {sub}: not supported by this repo's tracker stand-in")


if __name__ == "__main__":
    main(sys.argv[1:])
