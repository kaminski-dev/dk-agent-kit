+import pathlib
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parent.parent
+
+
+class HistoryOutput(unittest.TestCase):
+    def test_missing_value_prints_as_empty(self):
+        db = str(pathlib.Path(tempfile.mkdtemp()) / "ledger.db")
+        for command in ("seed", "history"):
+            out = subprocess.run([sys.executable, "-m", "ledger", command, "--db", db], cwd=ROOT,
+                                 capture_output=True, text=True, check=True).stdout
+        self.assertIn("(empty) -> Jansen BV", out)
+        self.assertIn("010-1234567 -> 010-7654321", out)
+
+
+if __name__ == "__main__":
+    unittest.main()
